---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

const READ_KEY = 'fn:read-posts';

interface Props {
	title: string;
	description: string;
	ogImageUrl?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, ogImageUrl } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolvedOgPath = ogImageUrl ?? `${base}/og/default.png`;
const ogImage = new URL(resolvedOgPath, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${SITE_TITLE} · Posts`}
	href={new URL(`${base}/rss.xml`, Astro.site)}
/>
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${SITE_TITLE} · Project updates`}
	href={new URL(`${base}/projects/rss.xml`, Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />
<Font cssVariable="--font-display" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<script is:inline define:vars={{ READ_KEY }}>
	const hydrateUnread = () => {
		let read = [];
		try {
			read = JSON.parse(localStorage.getItem(READ_KEY) || '[]');
		} catch {
			read = [];
		}
		const dots = document.querySelectorAll('[data-slug][data-unread]');
		dots.forEach((dot) => {
			const slug = dot.getAttribute('data-slug');
			const isRead = read.includes(slug);
			dot.setAttribute('data-unread', String(!isRead));
			dot.setAttribute('aria-label', isRead ? 'Mark as unread' : 'Mark as read');
			dot.setAttribute('title', isRead ? 'Read — click to mark unread' : 'Unread — click to mark read');
		});
	};
	const handleToggle = (event) => {
		const target = event.target.closest('[data-slug][data-unread]');
		if (!target) return;
		event.preventDefault();
		event.stopPropagation();
		const slug = target.getAttribute('data-slug');
		let read = [];
		try {
			read = JSON.parse(localStorage.getItem(READ_KEY) || '[]');
		} catch {
			read = [];
		}
		if (read.includes(slug)) {
			read = read.filter((s) => s !== slug);
		} else {
			read.push(slug);
		}
		localStorage.setItem(READ_KEY, JSON.stringify(read));
		hydrateUnread();
	};
	document.addEventListener('DOMContentLoaded', () => {
		hydrateUnread();
		document.addEventListener('click', handleToggle);
	});
	if (document.readyState !== 'loading') {
		hydrateUnread();
		document.addEventListener('click', handleToggle);
	}
</script>
