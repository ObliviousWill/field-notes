---
// A taped-on sticky note in the corner of every page. Visitors can dismiss it;
// the choice is remembered in their browser only.
const contactUrl = 'https://www.linkedin.com/in/williambaker7/';
---

<aside class="note" data-cta hidden>
	<a class="hand" href={contactUrl} target="_blank" rel="noopener">
		Need a hand becoming effective with AI?
		<span class="arrow" aria-hidden="true">→</span>
	</a>
	<button type="button" class="note-close" aria-label="Hide this note" data-cta-close>×</button>
</aside>
<script is:inline>
	(function () {
		var KEY = 'fn:cta-dismissed';
		var el = document.querySelector('[data-cta]');
		if (!el) return;
		var dismissed = false;
		try {
			dismissed = localStorage.getItem(KEY) === '1';
		} catch (e) {}
		if (dismissed) return;
		// On phones, wait until the reader has scrolled past the first screen so the
		// note never sits on top of what they came to read.
		var small = window.matchMedia('(max-width: 720px)').matches;
		if (!small) {
			el.hidden = false;
		} else {
			var onScroll = function () {
				if (window.scrollY > window.innerHeight * 0.9) {
					el.hidden = false;
					window.removeEventListener('scroll', onScroll);
				}
			};
			window.addEventListener('scroll', onScroll, { passive: true });
		}
		el.querySelector('[data-cta-close]').addEventListener('click', function () {
			el.classList.add('peel');
			setTimeout(function () {
				el.hidden = true;
			}, 260);
			try {
				localStorage.setItem(KEY, '1');
			} catch (e) {}
		});
	})();
</script>
<style>
	.note {
		position: fixed;
		right: 22px;
		bottom: calc(22px + env(safe-area-inset-bottom, 0px));
		z-index: 20;
		width: 172px;
		padding: 22px 16px 16px;
		background: linear-gradient(170deg, #fff1a8 0%, var(--sticky) 70%, #f6d96b 100%);
		box-shadow:
			0 1px 1px rgba(0, 0, 0, 0.06),
			0 10px 18px -6px rgba(60, 45, 0, 0.35);
		transform: rotate(2.5deg);
		transform-origin: top center;
		transition: transform 220ms ease, opacity 220ms ease;
		animation: stick 420ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
	}
	.note[hidden] {
		display: none;
	}
	.note::before {
		/* tape */
		content: '';
		position: absolute;
		top: -11px;
		left: 50%;
		width: 74px;
		height: 22px;
		margin-left: -37px;
		background: rgba(255, 255, 255, 0.55);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
		transform: rotate(-4deg);
	}
	.note:hover {
		transform: rotate(0.5deg) translateY(-3px);
	}
	.note a {
		display: block;
		color: #3b3216;
		font-size: 23px;
		line-height: 1.08;
		text-decoration: none;
		background-image: none;
	}
	.note a:hover {
		background-size: 0;
	}
	.arrow {
		display: inline-block;
		margin-left: 2px;
		transition: transform 200ms ease;
	}
	.note:hover .arrow {
		transform: translateX(4px);
	}
	.note-close {
		position: absolute;
		top: 4px;
		right: 4px;
		width: 26px;
		height: 26px;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: #6b5a1e;
		font-size: 17px;
		line-height: 1;
		cursor: pointer;
		opacity: 0.6;
	}
	.note-close:hover {
		opacity: 1;
	}
	.note.peel {
		opacity: 0;
		transform: rotate(14deg) translate(30px, 40px);
	}
	@keyframes stick {
		from {
			opacity: 0;
			transform: rotate(10deg) translateY(30px) scale(0.92);
		}
		to {
			opacity: 1;
			transform: rotate(2.5deg);
		}
	}
	@media (max-width: 720px) {
		.note {
			width: 118px;
			right: 10px;
			bottom: calc(12px + env(safe-area-inset-bottom, 0px));
			padding: 16px 10px 10px;
		}
		.note a {
			font-size: 17px;
		}
		.note::before {
			width: 56px;
			margin-left: -28px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.note {
			animation: none;
			transition: none;
		}
	}
</style>
