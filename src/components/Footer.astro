---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Will. All rights reserved.
	<div class="social-links">
		<a href="https://www.linkedin.com/in/williambaker7/" target="_blank" rel="noopener">
			<span class="sr-only">Connect on LinkedIn</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24"
				><path
					fill="currentColor"
					d="M13.632 13.635h-2.37V9.922c0-.886-.018-2.025-1.234-2.025-1.235 0-1.424.964-1.424 1.96v3.778h-2.37V6h2.275v1.04h.032c.317-.6 1.091-1.233 2.246-1.233 2.4 0 2.845 1.58 2.845 3.637v4.191zM3.558 4.957a1.375 1.375 0 1 1 0-2.75 1.375 1.375 0 0 1 0 2.75zm1.187 8.678H2.37V6h2.375v7.635zM14.816 0H1.18C.528 0 0 .516 0 1.153v13.694C0 15.484.528 16 1.18 16h13.635c.652 0 1.185-.516 1.185-1.153V1.153C16 .516 15.467 0 14.815 0h.001z"
				></path></svg
			>
		</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background-color: var(--bg);
		color: rgb(var(--text-muted));
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--text-muted));
	}
	.social-links a:hover {
		color: rgb(var(--text));
	}
</style>
