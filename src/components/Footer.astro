---
const today = new Date();
---

<footer>
	<div class="copy">&copy; {today.getFullYear()} Will. All rights reserved.</div>
	<a
		class="linkedin"
		href="https://www.linkedin.com/in/williambaker7/"
		target="_blank"
		rel="noopener"
		aria-label="Connect on LinkedIn"
	>
		<svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14"
			><path
				fill="currentColor"
				d="M13.632 13.635h-2.37V9.922c0-.886-.018-2.025-1.234-2.025-1.235 0-1.424.964-1.424 1.96v3.778h-2.37V6h2.275v1.04h.032c.317-.6 1.091-1.233 2.246-1.233 2.4 0 2.845 1.58 2.845 3.637v4.191zM3.558 4.957a1.375 1.375 0 1 1 0-2.75 1.375 1.375 0 0 1 0 2.75zm1.187 8.678H2.37V6h2.375v7.635zM14.816 0H1.18C.528 0 0 .516 0 1.153v13.694C0 15.484.528 16 1.18 16h13.635c.652 0 1.185-.516 1.185-1.153V1.153C16 .516 15.467 0 14.815 0h.001z"
			></path></svg
		>
	</a>
</footer>
<style>
	footer {
		background: var(--bg-tint);
		border-top: 1px solid var(--hairline);
		padding: 40px 40px 48px;
		text-align: center;
		color: rgb(var(--text-muted));
		font-size: 15px;
	}
	.copy {
		margin-bottom: 14px;
	}
	.linkedin {
		display: inline-flex;
		width: 22px;
		height: 22px;
		align-items: center;
		justify-content: center;
		background: #4b5b73;
		color: var(--bg-soft);
		border-radius: 3px;
		text-decoration: none;
		background-image: none;
	}
	.linkedin:hover {
		background-size: 0;
		background: #3b4a61;
	}
	@media (max-width: 720px) {
		footer {
			padding: 28px 20px 36px;
		}
	}
</style>
