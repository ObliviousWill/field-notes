---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2 class="brand">
			<a href={`${import.meta.env.BASE_URL}/`} class="logo-link">
				<img src={`${import.meta.env.BASE_URL}/logo.svg`} alt={SITE_TITLE} class="logo" />
				<span class="sr-only">{SITE_TITLE}</span>
			</a>
		</h2>
		<button
			type="button"
			class="burger"
			aria-expanded="false"
			aria-controls="primary-menu"
			aria-label="Open menu"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28">
				<path
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					d="M4 7h16M4 12h16M4 17h16"></path>
			</svg>
		</button>
		<div id="primary-menu" class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://www.linkedin.com/in/williambaker7/" target="_blank" rel="noopener">
				<span class="sr-only">Connect on LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24"
					><path
						fill="currentColor"
						d="M13.632 13.635h-2.37V9.922c0-.886-.018-2.025-1.234-2.025-1.235 0-1.424.964-1.424 1.96v3.778h-2.37V6h2.275v1.04h.032c.317-.6 1.091-1.233 2.246-1.233 2.4 0 2.845 1.58 2.845 3.637v4.191zM3.558 4.957a1.375 1.375 0 1 1 0-2.75 1.375 1.375 0 0 1 0 2.75zm1.187 8.678H2.37V6h2.375v7.635zM14.816 0H1.18C.528 0 0 .516 0 1.153v13.694C0 15.484.528 16 1.18 16h13.635c.652 0 1.185-.516 1.185-1.153V1.153C16 .516 15.467 0 14.815 0h.001z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<script>
	const burger = document.querySelector<HTMLButtonElement>('.burger');
	const nav = burger?.closest('nav');
	const closeMenu = () => {
		burger?.setAttribute('aria-expanded', 'false');
		nav?.classList.remove('menu-open');
	};
	burger?.addEventListener('click', () => {
		const isOpen = burger.getAttribute('aria-expanded') === 'true';
		burger.setAttribute('aria-expanded', String(!isOpen));
		nav?.classList.toggle('menu-open', !isOpen);
	});
	nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--bg-soft);
		box-shadow: 0 1px 0 rgba(var(--text), 8%);
	}
	nav {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: space-between;
	}
	.brand {
		margin: 0;
		font-size: 1em;
	}
	.logo-link {
		display: inline-flex;
		align-items: center;
		padding: 0.5em 0;
		text-decoration: none;
		color: rgb(var(--text));
	}
	.logo {
		height: 36px;
		width: auto;
		display: block;
		border-radius: 0;
	}
	.burger {
		display: none;
		background: none;
		border: 0;
		padding: 0.5em;
		cursor: pointer;
		color: rgb(var(--text));
		align-items: center;
	}
	.burger:focus-visible {
		outline: 2px solid var(--accent-ink);
		outline-offset: 2px;
		border-radius: 2px;
	}
	.internal-links {
		display: flex;
		gap: 0.25em;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--text));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
	}
	.social-links a {
		padding: 0.5em;
		border-bottom: none;
	}
	@media (min-width: 721px) {
		nav {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
		}
		.brand {
			justify-self: start;
		}
		.internal-links {
			justify-self: center;
		}
		.social-links {
			justify-self: end;
		}
	}
	@media (max-width: 720px) {
		.burger {
			display: inline-flex;
		}
		.internal-links,
		.social-links {
			flex-basis: 100%;
			display: none;
			flex-direction: column;
			align-items: stretch;
			padding-bottom: 0.5em;
		}
		nav.menu-open .internal-links,
		nav.menu-open .social-links {
			display: flex;
		}
		.internal-links a {
			padding: 0.6em 0;
			border-bottom: 1px solid rgba(var(--text), 8%);
		}
		.internal-links a.active {
			border-bottom-color: var(--accent);
		}
		.social-links a {
			padding: 0.6em 0;
			justify-content: flex-start;
		}
	}
</style>
