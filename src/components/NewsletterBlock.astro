---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rssUrl = `${base}/rss.xml`;
---

<section class="newsletter">
	<div class="title">Get these in your inbox.</div>
	<p class="lead">
		Roughly weekly. No schedule, no spam, just a heads-up when a new note goes up.
	</p>
	<form action="#" method="post" class="form">
		<input type="email" name="email" placeholder="you@email.com" aria-label="Email address" />
		<button type="submit">Subscribe →</button>
		<span class="rss">
			or grab the <a class="fn-link" href={rssUrl}>RSS feed ↗</a>
		</span>
	</form>
</section>
<style>
	.newsletter {
		margin-top: 56px;
		padding-top: 36px;
		border-top: 1px solid var(--hairline);
	}
	.title {
		font-family: var(--font-display);
		font-size: 34px;
		color: rgb(var(--text));
		margin-bottom: 8px;
		line-height: 1.1;
	}
	.lead {
		color: rgb(var(--text-muted));
		font-size: 17px;
		margin: 0 0 18px;
		max-width: 520px;
	}
	.form {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		align-items: center;
	}
	input[type='email'] {
		flex: 1 1 220px;
		min-width: 200px;
		padding: 12px 14px;
		border: 1px solid var(--hairline);
		background: var(--bg-soft);
		color: rgb(var(--text));
		font-size: 16px;
		border-radius: 4px;
		font-family: var(--font-atkinson);
		outline: none;
	}
	input[type='email']:focus {
		border-color: var(--accent-ink);
	}
	button {
		padding: 12px 18px;
		background: rgb(var(--text));
		color: var(--bg-soft);
		border: 0;
		font-size: 15px;
		font-weight: 700;
		border-radius: 4px;
		cursor: pointer;
		font-family: var(--font-atkinson);
	}
	button:hover {
		background: rgb(var(--text-muted));
	}
	.rss {
		color: rgb(var(--text-muted));
		font-size: 14px;
		margin-left: 8px;
	}
	@media (max-width: 720px) {
		.newsletter {
			margin-top: 36px;
			padding-top: 28px;
		}
		.title {
			font-size: 28px;
		}
		.lead {
			font-size: 16px;
		}
		.rss {
			margin-left: 0;
			flex-basis: 100%;
		}
	}
</style>
