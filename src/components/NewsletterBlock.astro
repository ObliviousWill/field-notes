---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rssUrl = `${base}/rss.xml`;
const newsletterUrl = 'https://www.linkedin.com/newsletters/7515924774427136000/';
---

<section class="newsletter">
	<div class="title">Get new posts as they land.</div>
	<p class="lead">
		Every post also goes out as a free newsletter on LinkedIn. Subscribe there and you'll
		get a heads-up whenever something new goes up.
	</p>
	<div class="form">
		<a class="subscribe" href={newsletterUrl} target="_blank" rel="noopener">
			Subscribe on LinkedIn →
		</a>
		<span class="rss">
			or grab the <a class="fn-link" href={rssUrl}>RSS feed ↗</a>
		</span>
	</div>
</section>
<style>
	.newsletter {
		margin-top: 56px;
		padding-top: 36px;
		border-top: 1px solid var(--hairline);
	}
	.title {
		font-family: var(--font-atkinson);
		font-weight: 700;
		font-size: 24px;
		color: rgb(var(--text));
		margin-bottom: 8px;
		line-height: 1.2;
		letter-spacing: -0.005em;
	}
	.lead {
		color: rgb(var(--text-muted));
		font-size: 17px;
		margin: 0 0 18px;
		max-width: 520px;
	}
	.form {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		align-items: center;
	}
	.subscribe {
		padding: 12px 18px;
		background: rgb(var(--text));
		color: var(--bg-soft);
		border: 0;
		font-size: 15px;
		font-weight: 700;
		border-radius: 4px;
		cursor: pointer;
		font-family: var(--font-atkinson);
		text-decoration: none;
		background-image: none;
		display: inline-block;
	}
	.subscribe:hover {
		background: rgb(var(--text-muted));
	}
	.rss {
		color: rgb(var(--text-muted));
		font-size: 14px;
		margin-left: 8px;
	}
	@media (max-width: 720px) {
		.newsletter {
			margin-top: 36px;
			padding-top: 28px;
		}
		.title {
			font-size: 20px;
		}
		.lead {
			font-size: 16px;
		}
		.rss {
			margin-left: 0;
			flex-basis: 100%;
		}
	}
</style>
