---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import StatusPill from './StatusPill.astro';
import { getUpdatesForProject } from '../utils/projects';

interface Props {
	project: CollectionEntry<'projects'>;
	expanded?: boolean;
}

const { project, expanded = false } = Astro.props;
const updates = await getUpdatesForProject(project.id);
const latest = updates[0];
const count = updates.length;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/projects/${project.id}/`;
---

<article class="project-card">
	<header>
		<p class="kicker">Project</p>
		<StatusPill status={project.data.status} />
	</header>
	<a class="title" href={href}>{project.data.title}</a>
	<p class="summary">{project.data.summary}</p>
	<div class="footer">
		<span class="latest-label">Latest</span>
		{
			latest ? (
				<>
					<a class="fn-link" href={href}>{latest.data.title}</a>
					<span class="sep" aria-hidden="true">·</span>
					<FormattedDate date={latest.data.pubDate} />
				</>
			) : (
				<span class="empty">No updates yet</span>
			)
		}
		{
			expanded && (
				<>
					<span class="spacer"></span>
					<span class="count">
						{count} {count === 1 ? 'update' : 'updates'}
					</span>
				</>
			)
		}
	</div>
</article>
<style>
	.project-card {
		position: relative;
		background: var(--bg-soft);
		border: 1px solid var(--hairline-soft);
		border-radius: 8px;
		padding: 28px;
		transition: border-color 200ms ease;
	}
	.project-card:hover {
		border-color: rgba(255, 177, 98, 0.7);
	}
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 14px;
	}
	header .kicker {
		margin: 0;
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgb(var(--text-muted));
		font-weight: 700;
	}
	.title {
		display: inline-block;
		font-family: var(--font-atkinson);
		font-weight: 700;
		font-size: 24px;
		line-height: 1.2;
		letter-spacing: -0.005em;
		color: rgb(var(--text));
		text-decoration: none;
		margin: 0 0 12px;
		background-image: linear-gradient(var(--accent), var(--accent));
		background-position: 0 100%;
		background-repeat: no-repeat;
		background-size: 0 4px;
		transition: background-size 280ms cubic-bezier(0.6, 0, 0.2, 1);
		padding-bottom: 2px;
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
		border-radius: 1px;
	}
	.project-card:hover .title {
		background-size: 100% 4px;
	}
	.summary {
		color: rgb(var(--text-muted));
		font-size: 17px;
		margin: 0 0 16px;
		line-height: 1.55;
	}
	.footer {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;
		font-size: 13px;
		color: rgb(var(--text-muted));
		font-family: var(--font-atkinson);
		padding-top: 14px;
		border-top: 1px dashed var(--hairline-soft);
	}
	.latest-label {
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-size: 11px;
		font-weight: 700;
	}
	.sep {
		opacity: 0.4;
	}
	.empty {
		font-style: italic;
	}
	.spacer {
		flex: 1;
	}
	.count {
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-weight: 700;
	}
	@media (max-width: 720px) {
		.project-card {
			padding: 20px;
		}
		.title {
			font-size: 20px;
		}
		.summary {
			font-size: 16px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.project-card,
		.title {
			transition: none;
		}
	}
</style>
