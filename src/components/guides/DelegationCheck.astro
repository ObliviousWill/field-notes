---
import ToolBox from './ToolBox.astro';

const questions = [
	['stakes', 'Would a mistake be costly, or hard to undo?'],
	['personal', 'Does it depend on your relationships, or on things only you know?'],
	['checkable', 'Could you quickly check whether the result is right?'],
	['repeat', 'Is it something you do often, in much the same way?'],
];
---

<ToolBox title="Hand it over, or keep it?">
	<div data-deleg>
		<label>The task<span class="hint">e.g. "Write the agenda for Thursday's team meeting"</span>
			<input type="text" data-task /></label>
		{
			questions.map(([key, q]) => (
				<fieldset class="q" data-q={key}>
					<legend>{q}</legend>
					<label><input type="radio" name={`d-${key}`} value="yes" /> Yes</label>
					<label><input type="radio" name={`d-${key}`} value="no" /> No</label>
				</fieldset>
			))
		}
		<div class="verdict" data-verdict hidden aria-live="polite"></div>
	</div>
</ToolBox>
<style>
	.q {
		border: 0;
		margin: 14px 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 6px 16px;
		align-items: center;
	}
	.q legend {
		font-weight: 700;
		font-size: 14px;
		margin-bottom: 6px;
		padding: 0;
		width: 100%;
	}
	.q label {
		display: inline-flex !important;
		gap: 6px;
		align-items: center;
		margin: 0 !important;
		font-weight: 400 !important;
	}
</style>
<script>
	document.querySelectorAll<HTMLElement>('[data-deleg]').forEach((root) => {
		const v = root.querySelector<HTMLElement>('[data-verdict]')!;
		const answer = (k: string) =>
			root.querySelector<HTMLInputElement>(`[data-q="${k}"] input:checked`)?.value;
		const render = () => {
			const a = {
				stakes: answer('stakes'),
				personal: answer('personal'),
				checkable: answer('checkable'),
				repeat: answer('repeat'),
			};
			if (Object.values(a).some((x) => !x)) {
				v.hidden = true;
				return;
			}
			const task = (root.querySelector<HTMLInputElement>('[data-task]')!.value || 'this task').trim();
			let head: string;
			let body: string;
			if (a.stakes === 'yes' && a.checkable === 'no') {
				head = 'Keep this one, and use Claude for the groundwork.';
				body = `A mistake would matter and would be hard to spot. Ask Claude to help you prepare for "${task}": gather information, suggest questions, or outline options. Do the task itself yourself.`;
			} else if (a.personal === 'yes' || a.stakes === 'yes') {
				head = 'Do it together.';
				body = `Let Claude draft or suggest, and you lead. For "${task}", ask for a first version, then bring what only you know: the relationships, the context, the final call.`;
			} else {
				head = 'Hand it over.';
				body = `"${task}" is a good job to delegate. Give Claude a clear brief (guide 3), check the result (guide 5), and you're done.`;
			}
			if (a.repeat === 'yes') {
				body += ' Because you do it often, it could also become a skill, so you only explain it once (guide 7).';
			}
			v.innerHTML = '';
			const s = document.createElement('strong');
			s.textContent = head;
			const p = document.createElement('span');
			p.textContent = body;
			v.append(s, p);
			v.hidden = false;
		};
		root.addEventListener('change', render);
		root.addEventListener('input', render);
	});
</script>
