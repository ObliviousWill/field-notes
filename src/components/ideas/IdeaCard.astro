---
import type { CollectionEntry } from 'astro:content';
interface Props {
	idea: CollectionEntry<'ideas'>;
}
const { idea } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const kindLabel = { quiz: 'Quiz', calculator: 'Calculator', checker: 'Checker', game: 'Game', planner: 'Planner' }[idea.data.kind];
---

<a class="idea-card" href={`${base}/ideas/${idea.id}/`} style={`--idea:${idea.data.accent}`}>
	<span class="tile" aria-hidden="true"><span class="emoji">{idea.data.emoji}</span></span>
	<span class="meta"><span class="kind">{kindLabel}</span> · {idea.data.business}</span>
	<span class="title">{idea.data.title}</span>
	<span class="summary">{idea.data.summary}</span>
	<span class="cta">Try it, then steal it →</span>
</a>
<style>
	.idea-card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		height: 100%;
		box-sizing: border-box;
		padding: 14px 14px 18px;
		background: var(--bg-soft);
		border: 1px solid var(--hairline-soft);
		border-radius: 14px;
		text-decoration: none;
		background-image: none;
		color: rgb(var(--text));
		transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
	}
	.idea-card:hover,
	.idea-card:focus-visible {
		transform: translateY(-3px);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
		border-color: var(--idea);
		background-size: 0;
	}
	.tile {
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 10;
		border-radius: 10px;
		background:
			radial-gradient(circle at 25% 20%, rgba(255, 255, 255, 0.35), transparent 45%),
			var(--idea);
	}
	.emoji {
		font-size: 56px;
		transition: transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.idea-card:hover .emoji {
		transform: scale(1.18) rotate(-8deg);
	}
	.meta {
		font-size: 12px;
		letter-spacing: 0.04em;
		color: rgb(var(--text-muted));
	}
	.kind {
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--idea);
		filter: brightness(0.8);
	}
	.title {
		font-family: var(--font-display);
		font-size: 21px;
		line-height: 1.15;
	}
	.summary {
		font-size: 14px;
		line-height: 1.45;
		color: rgb(var(--text-muted));
		flex: 1;
	}
	.cta {
		font-size: 13px;
		font-weight: 700;
		color: var(--accent-ink);
	}
	@media (prefers-reduced-motion: reduce) {
		.idea-card,
		.emoji {
			transition: none;
		}
	}
</style>
