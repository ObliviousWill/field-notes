---
import { getEntry, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CategoryChip from '../components/CategoryChip.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import PostRow from '../components/PostRow.astro';
import StatusPill from '../components/StatusPill.astro';
import { SITE_AUTHOR } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	readingTime?: number;
	nextPost?: CollectionEntry<'blog'> | null;
	ogImageUrl?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	tags,
	author,
	readingTime,
	nextPost,
	ogImageUrl,
	mentions,
} = Astro.props;

const byline = author ?? SITE_AUTHOR;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const resolvedMentions = mentions
	? (
			await Promise.all(
				mentions.map(async (ref) => {
					const entry = await getEntry('projects', ref.id);
					return entry ? { id: entry.id, data: entry.data } : null;
				}),
			)
		).filter((m): m is { id: string; data: CollectionEntry<'projects'>['data'] } => m !== null)
	: [];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} ogImageUrl={ogImageUrl} />
	</head>
	<body>
		<Header current="blog" />

		<div class="progress" aria-hidden="true">
			<div class="progress-fill" data-progress-fill></div>
		</div>

		<main>
			<div class="crumbs">
				<a class="fn-link" href={`${base}/blog/`}>← All notes</a>
				<span class="left">
					<span class="left-dot" aria-hidden="true"></span>
					<span class="left-text">
						<span data-progress-remaining>~{readingTime}</span> min left of {readingTime}
					</span>
				</span>
			</div>

			<header class="post-head">
				{
					tags && tags.length > 0 && (
						<div class="chips">
							{tags.map((tag) => (
								<CategoryChip tag={tag} size="lg" />
							))}
						</div>
					)
				}
				<h1>{title}</h1>
				{description && <p class="dek">{description}</p>}
				<div class="byline">
					<strong>{byline}</strong>
					<span class="sep" aria-hidden="true">·</span>
					<FormattedDate date={pubDate} />
					{
						readingTime && (
							<>
								<span class="sep" aria-hidden="true">·</span>
								<span>{readingTime} min read</span>
							</>
						)
					}
					{
						updatedDate && (
							<>
								<span class="sep" aria-hidden="true">·</span>
								<span class="updated">
									<span class="updated-icon">↻</span> updated{' '}
									<FormattedDate date={updatedDate} />
								</span>
							</>
						)
					}
				</div>
			</header>

			<article class="prose">
				<slot />
			</article>

			{
				resolvedMentions.length > 0 && (
					<aside class="mentions">
						<p class="mentions-label">Mentions</p>
						<div class="mentions-list">
							{resolvedMentions.map((m) => (
								<a class="mention" href={`${base}/projects/${m.id}/`}>
									<StatusPill status={m.data.status} />
									<span class="mention-title">{m.data.title}</span>
									<span class="mention-cta">Project ↗</span>
								</a>
							))}
						</div>
					</aside>
				)
			}

			{
				nextPost && (
					<section class="next">
						<p class="next-label">Next note</p>
						<ol class="next-list">
							<PostRow post={nextPost} compact />
						</ol>
					</section>
				)
			}

			<NewsletterBlock />
		</main>
		<Footer />
		<script is:inline>
			const fill = document.querySelector('[data-progress-fill]');
			const remaining = document.querySelector('[data-progress-remaining]');
			const readingTimeEl = document.querySelector('[data-progress-remaining]');
			const totalTime = readingTimeEl
				? parseInt(readingTimeEl.textContent.replace(/[^\d]/g, ''), 10) || 1
				: 1;
			const update = () => {
				const max = document.documentElement.scrollHeight - window.innerHeight;
				const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
				if (fill) fill.style.width = (ratio * 100).toFixed(2) + '%';
				if (remaining) {
					const left = Math.max(0, Math.round(totalTime * (1 - ratio)));
					remaining.textContent = '~' + left;
				}
			};
			update();
			window.addEventListener('scroll', update, { passive: true });
			window.addEventListener('resize', update);
		</script>
	</body>
</html>
<style>
	main {
		padding-top: 40px;
		padding-bottom: 72px;
	}
	.progress {
		height: 3px;
		background: var(--hairline-soft);
		position: sticky;
		top: 0;
		z-index: 10;
	}
	.progress-fill {
		height: 100%;
		width: 0%;
		background: var(--accent);
		transition: width 200ms ease;
	}
	.crumbs {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 36px;
		font-size: 13px;
		color: rgb(var(--text-muted));
		flex-wrap: wrap;
		gap: 8px;
	}
	.left {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.left-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
	}
	.left-text {
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-size: 11px;
	}
	.post-head {
		margin-bottom: 40px;
	}
	.chips {
		display: flex;
		gap: 8px;
		margin-bottom: 18px;
		flex-wrap: wrap;
	}
	.post-head h1 {
		font-family: var(--font-display);
		font-size: 56px;
		margin: 0;
		line-height: 1.08;
		letter-spacing: -0.01em;
		color: rgb(var(--text));
		text-wrap: pretty;
	}
	.dek {
		font-style: italic;
		color: rgb(var(--text-muted));
		font-size: 22px;
		line-height: 1.45;
		margin: 24px 0 28px;
		max-width: 620px;
	}
	.byline {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;
		font-size: 14px;
		color: rgb(var(--text-muted));
		padding-top: 22px;
		border-top: 1px solid var(--hairline-soft);
	}
	.byline strong {
		color: rgb(var(--text));
		font-weight: 700;
	}
	.byline .sep {
		opacity: 0.4;
	}
	.updated {
		color: var(--accent-ink);
	}
	.updated-icon {
		font-size: 11px;
	}
	.prose {
		max-width: 680px;
	}
	.mentions {
		margin-top: 56px;
		padding-top: 28px;
		border-top: 1px solid var(--hairline-soft);
		display: grid;
		grid-template-columns: 180px 1fr;
		gap: 28px;
	}
	.mentions-label {
		font-family: var(--font-display);
		font-size: 20px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: rgb(var(--text));
		margin: 0;
	}
	.mentions-list {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.mention {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px 14px;
		background: var(--bg-soft);
		border: 1px solid var(--hairline-soft);
		border-radius: 6px;
		font-size: 14px;
		color: rgb(var(--text-muted));
		text-decoration: none;
		background-image: none;
		transition: border-color 200ms ease;
	}
	.mention:hover {
		border-color: rgba(255, 177, 98, 0.7);
		background-size: 0;
	}
	.mention-title {
		color: var(--accent-ink);
		font-weight: 700;
		font-size: 15px;
	}
	.mention-cta {
		margin-left: auto;
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.next {
		margin-top: 64px;
		padding-top: 36px;
		border-top: 1px solid var(--hairline);
	}
	.next-label {
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgb(var(--text-muted));
		margin: 0 0 12px;
		font-weight: 700;
	}
	.next-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	@media (max-width: 720px) {
		main {
			padding-top: 24px;
		}
		.crumbs {
			margin-bottom: 24px;
		}
		.post-head {
			margin-bottom: 28px;
		}
		.post-head h1 {
			font-size: 36px;
		}
		.dek {
			font-size: 19px;
			margin: 18px 0 22px;
		}
		.byline {
			padding-top: 18px;
		}
		.mentions {
			grid-template-columns: 1fr;
			gap: 12px;
			margin-top: 36px;
		}
		.mentions-label {
			font-size: 18px;
		}
		.next {
			margin-top: 40px;
			padding-top: 28px;
		}
	}
</style>
