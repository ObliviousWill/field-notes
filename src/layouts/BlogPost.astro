---
import { getEntry, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CategoryChip from '../components/CategoryChip.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import FourD from '../components/FourD.astro';
import GuideDone from '../components/guides/GuideDone.astro';
import Header from '../components/Header.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import PostRow from '../components/PostRow.astro';
import StatusPill from '../components/StatusPill.astro';
import { SITE_AUTHOR } from '../consts';

type Props = Omit<CollectionEntry<'blog'>['data'], 'tags' | 'mentions'> & {
	tags?: CollectionEntry<'blog'>['data']['tags'];
	mentions?: CollectionEntry<'blog'>['data']['mentions'];
	readingTime?: number;
	nextPost?: CollectionEntry<'blog'> | null;
	ogImageUrl?: string;
	// guides reuse this layout with their own crumbs and next link
	section?: 'blog' | 'guides';
	step?: number;
	stepCount?: number;
	nextGuide?: { href: string; title: string; description: string } | null;
	fourD?: 'delegation' | 'description' | 'discernment' | 'diligence';
	guideSlug?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	tags,
	author,
	readingTime,
	nextPost,
	ogImageUrl,
	mentions,
	audio,
	section = 'blog',
	step,
	stepCount,
	nextGuide,
	fourD,
	guideSlug,
} = Astro.props;

const byline = author ?? SITE_AUTHOR;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const resolvedMentions = mentions
	? (
			await Promise.all(
				mentions.map(async (ref) => {
					const entry = await getEntry('projects', ref.id);
					return entry ? { id: entry.id, data: entry.data } : null;
				}),
			)
		).filter((m): m is { id: string; data: CollectionEntry<'projects'>['data'] } => m !== null)
	: [];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} ogImageUrl={ogImageUrl} />
	</head>
	<body>
		<Header current={section} />

		<div class="progress" aria-hidden="true">
			<div class="progress-fill" data-progress-fill></div>
		</div>

		<main>
			<div class="crumbs">
				{
					section === 'guides' ? (
						<a class="fn-link" href={`${base}/guides/`}>← All guides</a>
					) : (
						<a class="fn-link" href={`${base}/blog/`}>← All notes</a>
					)
				}
				<span class="left">
					<span class="left-dot" aria-hidden="true"></span>
					<span class="left-text">
						<span data-progress-remaining>~{readingTime}</span> min left of {readingTime}
					</span>
				</span>
			</div>

			<header class="post-head">
				{step && (
					<p class="step-label">
						Guide {step}
						{stepCount && ` of ${stepCount}`}
					</p>
				)}
				{
					tags && tags.length > 0 && (
						<div class="chips">
							{tags.map((tag) => (
								<CategoryChip tag={tag} size="lg" />
							))}
						</div>
					)
				}
				<h1>{title}</h1>
				{description && <p class="dek">{description}</p>}
				<div class="byline">
					<strong>{byline}</strong>
					<span class="sep" aria-hidden="true">·</span>
					<span class="stamp"><FormattedDate date={pubDate} /></span>
					{
						readingTime && (
							<>
								<span class="sep" aria-hidden="true">·</span>
								<span>{readingTime} min read</span>
							</>
						)
					}
					{
						updatedDate && (
							<>
								<span class="sep" aria-hidden="true">·</span>
								<span class="updated">
									<span class="updated-icon">↻</span> updated{' '}
									<FormattedDate date={updatedDate} />
								</span>
							</>
						)
					}
				</div>
				{fourD && <FourD current={fourD} />}
				{
					audio && (
						<figure class="listen">
							<figcaption class="listen-label">Prefer to listen? Play the audio version, read by an AI version of my voice.</figcaption>
							<audio controls preload="none" src={`${base}${audio}`}>
								<a href={`${base}${audio}`}>Download the recording</a>
							</audio>
						</figure>
					)
				}
			</header>

			<article class="prose">
				<slot />
			</article>

			{guideSlug && <GuideDone slug={guideSlug} />}

			<aside class="toc" data-toc aria-label="On this page" hidden>
				<p class="toc-label">On this page</p>
				<ol class="toc-list" data-toc-list></ol>
			</aside>

			{
				resolvedMentions.length > 0 && (
					<aside class="mentions">
						<p class="mentions-label">Mentions</p>
						<div class="mentions-list">
							{resolvedMentions.map((m) => (
								<a class="mention" href={`${base}/projects/${m.id}/`}>
									<StatusPill status={m.data.status} />
									<span class="mention-title">{m.data.title}</span>
									<span class="mention-cta">Project ↗</span>
								</a>
							))}
						</div>
					</aside>
				)
			}

			{
				nextGuide && (
					<section class="next">
						<p class="next-label">Next guide</p>
						<a class="next-guide" href={nextGuide.href}>
							<span class="next-guide-title">{nextGuide.title}</span>
							<span class="next-guide-desc">{nextGuide.description}</span>
						</a>
					</section>
				)
			}

			{
				nextPost && (
					<section class="next">
						<p class="next-label">Next note</p>
						<ol class="next-list">
							<PostRow post={nextPost} compact />
						</ol>
					</section>
				)
			}

			<NewsletterBlock />
		</main>
		<Footer />
		<script is:inline>
			(function () {
				const fill = document.querySelector('[data-progress-fill]');
				const remaining = document.querySelector('[data-progress-remaining]');
				const totalTime = remaining
					? parseInt(remaining.textContent.replace(/[^\d]/g, ''), 10) || 1
					: 1;
				const scroller = document.scrollingElement || document.documentElement;
				const update = () => {
					const max = scroller.scrollHeight - window.innerHeight;
					const top = scroller.scrollTop || window.scrollY || 0;
					const ratio = max > 0 ? Math.min(1, Math.max(0, top / max)) : 0;
					if (fill) fill.style.width = (ratio * 100).toFixed(2) + '%';
					if (remaining) {
						const left = Math.max(0, Math.round(totalTime * (1 - ratio)));
						remaining.textContent = '~' + left;
					}
				};
				update();
				window.addEventListener('scroll', update, { passive: true });
				window.addEventListener('resize', update);

				const toc = document.querySelector('[data-toc]');
				const tocList = document.querySelector('[data-toc-list]');
				const headings = Array.from(
					document.querySelectorAll('.prose h2[id]'),
				);
				if (toc && tocList && headings.length >= 2) {
					const links = new Map();
					headings.forEach((h) => {
						const li = document.createElement('li');
						const a = document.createElement('a');
						a.href = '#' + h.id;
						a.textContent = h.textContent || '';
						li.appendChild(a);
						tocList.appendChild(li);
						links.set(h.id, a);
					});
					toc.hidden = false;
					const setActive = (id) => {
						links.forEach((a, key) => {
							if (key === id) a.setAttribute('data-active', '');
							else a.removeAttribute('data-active');
						});
					};
					setActive(headings[0].id);
					const observer = new IntersectionObserver(
						(entries) => {
							const visible = entries
								.filter((e) => e.isIntersecting)
								.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
							if (visible[0]) setActive(visible[0].target.id);
						},
						{ rootMargin: '-80px 0px -70% 0px', threshold: 0 },
					);
					headings.forEach((h) => observer.observe(h));
				}
			})();
		</script>
	</body>
</html>
<style>
	main {
		padding-top: 40px;
		padding-bottom: 72px;
	}
	.progress {
		height: 3px;
		background: var(--hairline-soft);
		position: sticky;
		top: 0;
		z-index: 10;
	}
	.progress-fill {
		height: 100%;
		width: 0%;
		background: var(--accent);
		transition: width 200ms ease;
	}
	.crumbs {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 36px;
		font-size: 13px;
		color: rgb(var(--text-muted));
		flex-wrap: wrap;
		gap: 8px;
	}
	.left {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.left-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
	}
	.left-text {
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-size: 11px;
	}
	.post-head {
		margin-bottom: 40px;
	}
	.chips {
		display: flex;
		gap: 8px;
		margin-bottom: 18px;
		flex-wrap: wrap;
	}
	.post-head h1 {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 56px;
		margin: 0;
		line-height: 1.05;
		letter-spacing: -0.015em;
		color: rgb(var(--text));
		text-wrap: pretty;
	}
	.dek {
		font-style: italic;
		color: rgb(var(--text-muted));
		font-size: 22px;
		line-height: 1.45;
		margin: 24px 0 28px;
		max-width: 620px;
	}
	.byline {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;
		font-size: 14px;
		color: rgb(var(--text-muted));
		padding-top: 22px;
		border-top: 1px solid var(--hairline-soft);
	}
	.byline strong {
		color: rgb(var(--text));
		font-weight: 700;
	}
	.byline .sep {
		opacity: 0.4;
	}
	.updated {
		color: var(--accent-ink);
	}
	.updated-icon {
		font-size: 11px;
	}
	.listen {
		margin: 22px 0 0;
		padding: 16px 18px;
		background: var(--bg-soft);
		border: 1px solid var(--hairline-soft);
		border-radius: 8px;
		max-width: 680px;
	}
	.listen-label {
		font-size: 14px;
		color: rgb(var(--text-muted));
		margin: 0 0 10px;
	}
	.listen audio {
		display: block;
		width: 100%;
	}
	.prose {
		max-width: 680px;
	}
	.toc {
		position: fixed;
		top: 140px;
		right: 32px;
		width: 220px;
		max-height: calc(100vh - 200px);
		overflow-y: auto;
		display: none;
		z-index: 5;
	}
	.toc[hidden] {
		display: none !important;
	}
	@media (min-width: 1180px) {
		.toc:not([hidden]) {
			display: block;
		}
	}
	.toc-label {
		font-size: 10px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-weight: 700;
		color: rgb(var(--text-muted));
		margin: 0 0 12px;
		padding-left: 14px;
	}
	.toc-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 1px solid var(--hairline);
	}
	.toc-list :global(li) {
		margin: 0;
		padding: 0;
	}
	.toc-list :global(a) {
		display: block;
		padding: 6px 14px;
		font-size: 13px;
		line-height: 1.35;
		color: rgb(var(--text-muted));
		text-decoration: none;
		background-image: none;
		border-left: 2px solid transparent;
		margin-left: -1px;
		transition: color 160ms ease, border-color 160ms ease;
	}
	.toc-list :global(a:hover) {
		color: rgb(var(--text));
		background-size: 0;
	}
	.toc-list :global(a[data-active]) {
		color: var(--accent-ink);
		border-left-color: var(--accent);
		font-weight: 700;
	}
	.mentions {
		margin-top: 56px;
		padding-top: 28px;
		border-top: 1px solid var(--hairline-soft);
		display: grid;
		grid-template-columns: 180px 1fr;
		gap: 28px;
	}
	.mentions-label {
		font-family: var(--font-atkinson);
		font-weight: 700;
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: rgb(var(--text-muted));
		margin: 0;
	}
	.mentions-list {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.mention {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px 14px;
		background: var(--bg-soft);
		border: 1px solid var(--hairline-soft);
		border-radius: 6px;
		font-size: 14px;
		color: rgb(var(--text-muted));
		text-decoration: none;
		background-image: none;
		transition: border-color 200ms ease;
	}
	.mention:hover {
		border-color: rgba(255, 177, 98, 0.7);
		background-size: 0;
	}
	.mention-title {
		color: var(--accent-ink);
		font-weight: 700;
		font-size: 15px;
	}
	.mention-cta {
		margin-left: auto;
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.next {
		margin-top: 64px;
		padding-top: 36px;
		border-top: 1px solid var(--hairline);
	}
	.next-label {
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgb(var(--text-muted));
		margin: 0 0 12px;
		font-weight: 700;
	}
	.step-label {
		font-size: 12px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-weight: 700;
		color: var(--accent-ink);
		margin: 0 0 14px;
	}
	.next-guide {
		display: block;
		padding: 18px 20px;
		background: var(--bg-soft);
		border: 1px solid var(--hairline-soft);
		border-radius: 8px;
		text-decoration: none;
		background-image: none;
	}
	.next-guide:hover {
		border-color: rgba(255, 177, 98, 0.7);
		background-size: 0;
	}
	.next-guide-title {
		display: block;
		font-family: var(--font-display);
		font-size: 24px;
		color: rgb(var(--text));
		margin-bottom: 6px;
	}
	.next-guide-desc {
		display: block;
		font-size: 15px;
		color: rgb(var(--text-muted));
	}
	.next-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	@media (max-width: 720px) {
		main {
			padding-top: 24px;
		}
		.crumbs {
			margin-bottom: 24px;
		}
		.post-head {
			margin-bottom: 28px;
		}
		.post-head h1 {
			font-size: 38px;
		}
		.dek {
			font-size: 19px;
			margin: 18px 0 22px;
		}
		.byline {
			padding-top: 18px;
		}
		.mentions {
			grid-template-columns: 1fr;
			gap: 12px;
			margin-top: 36px;
		}
		.mentions-label {
			font-size: 11px;
		}
		.next {
			margin-top: 40px;
			padding-top: 28px;
		}
	}
</style>
