---
import { Image } from 'astro:assets';
import type { CollectionEntry, MarkdownHeading } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { headings?: MarkdownHeading[] };

const { title, description, pubDate, updatedDate, heroImage, tags, headings } = Astro.props;
const tocHeadings = (headings ?? []).filter((h) => h.depth === 2);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.post-body {
				display: block;
				margin: 0 auto;
				max-width: 100%;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--text));
			}
			.toc {
				display: none;
			}
			@media (min-width: 1080px) {
				.post-body {
					display: grid;
					grid-template-columns: minmax(0, 720px) 220px;
					gap: 3rem;
					max-width: 1040px;
					padding: 0 1em;
				}
				.prose {
					width: auto;
					max-width: none;
					margin: 0;
					padding: 1em 0;
				}
				.toc {
					display: block;
					position: sticky;
					top: 2rem;
					align-self: start;
					max-height: calc(100vh - 4rem);
					overflow-y: auto;
					padding: 1.5em 0 0;
					font-size: 0.9em;
					line-height: 1.4;
				}
				.toc-label {
					margin: 0 0 0.75em;
					font-size: 0.75em;
					font-weight: 700;
					text-transform: uppercase;
					letter-spacing: 0.08em;
					color: rgb(var(--text-muted));
				}
				.toc ol {
					list-style: none;
					margin: 0;
					padding: 0;
					border-left: 2px solid rgba(var(--text), 10%);
				}
				.toc li {
					margin: 0;
				}
				.toc a {
					display: block;
					padding: 0.35em 0 0.35em 0.9em;
					margin-left: -2px;
					border-left: 2px solid transparent;
					color: rgb(var(--text-muted));
					text-decoration: none;
				}
				.toc a:hover {
					color: rgb(var(--text));
				}
				.toc a.active {
					color: var(--accent-ink);
					border-left-color: var(--accent);
					font-weight: 600;
				}
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.4em 0;
			}
			.description {
				margin: 0 auto 0.6em;
				max-width: 36em;
				color: rgb(var(--text-muted));
				font-style: italic;
				font-size: 1.125em;
				line-height: 1.4;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--text-muted));
			}
			.last-updated-on {
				font-style: italic;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5em;
				margin: 0.5em 0 0;
				padding: 0;
				list-style: none;
			}
			.tags li {
				font-size: 0.85em;
				color: var(--accent-ink);
				text-transform: lowercase;
				letter-spacing: 0.02em;
			}
			.tags li::before {
				content: '#';
				opacity: 0.7;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="post-body">
					<div class="prose">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							{description && <p class="description">{description}</p>}
							{
								tags && tags.length > 0 && (
									<ul class="tags">
										{tags.map((tag) => (
											<li>{tag}</li>
										))}
									</ul>
								)
							}
							<hr />
						</div>
						<slot />
					</div>
					{
						tocHeadings.length > 1 && (
							<aside class="toc" aria-label="Table of contents">
								<p class="toc-label">On this page</p>
								<ol>
									{tocHeadings.map((h) => (
										<li>
											<a href={`#${h.slug}`} data-toc-link={h.slug}>
												{h.text}
											</a>
										</li>
									))}
								</ol>
							</aside>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
		<script>
			const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
			if (links.length > 0) {
				const linkBySlug = new Map<string, HTMLAnchorElement>();
				const headingIds: string[] = [];
				links.forEach((link) => {
					const slug = link.dataset.tocLink;
					if (!slug) return;
					linkBySlug.set(slug, link);
					headingIds.push(slug);
				});

				const setActive = (slug: string | null) => {
					linkBySlug.forEach((link, s) => {
						link.classList.toggle('active', s === slug);
					});
				};

				const visible = new Set<string>();
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							const id = entry.target.id;
							if (entry.isIntersecting) visible.add(id);
							else visible.delete(id);
						});
						const firstVisible = headingIds.find((id) => visible.has(id));
						if (firstVisible) setActive(firstVisible);
					},
					{ rootMargin: '0px 0px -70% 0px', threshold: 0 },
				);

				headingIds.forEach((id) => {
					const el = document.getElementById(id);
					if (el) observer.observe(el);
				});

				setActive(headingIds[0] ?? null);
			}
		</script>
	</body>
</html>
