---
import BaseHead from '../../components/BaseHead.astro';

const REPO_OWNER = 'ObliviousWill';
const REPO_NAME = 'field-notes';
const BRANCH = 'main';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Admin · Field Notes" description="" noindex />
	</head>
	<body class="admin-body">
		<header class="topbar">
			<div class="topbar-left">
				<button id="back-to-list" class="brand-link" type="button" hidden>
					← Posts
				</button>
				<a class="brand" href={`${base}/`}>Field Notes</a>
				<span class="env-tag">admin</span>
				<span id="page-context" class="page-context"></span>
			</div>
			<button id="signout" class="signout" type="button" hidden>Sign out</button>
		</header>

		<!-- LOGIN -->
		<section class="shell narrow" data-view="login" hidden>
			<div class="card">
				<h1>Sign in</h1>
				<p class="lead">
					Paste a GitHub Personal Access Token with <code>contents:write</code> on
					this repo. Stored only in your browser.
				</p>
				<form id="login-form">
					<label>
						<span>GitHub PAT</span>
						<input
							id="token-input"
							type="password"
							autocomplete="off"
							spellcheck="false"
							required
							placeholder="ghp_..."
						/>
					</label>
					<p id="login-error" class="err" hidden></p>
					<button type="submit" class="primary">Sign in</button>
					<p class="hint">
						Fine-grained PAT, this repo only, contents read+write.
						<a
							href="https://github.com/settings/personal-access-tokens/new"
							target="_blank"
							rel="noopener">Create one →</a
						>
					</p>
				</form>
			</div>
		</section>

		<!-- LIST -->
		<section class="shell" data-view="list" hidden>
			<div class="list-head">
				<div>
					<h1>Posts</h1>
					<p class="lead" id="list-meta">Loading…</p>
				</div>
				<button id="new-post-btn" class="primary" type="button">+ New post</button>
			</div>
			<div id="post-list" class="post-list"></div>
		</section>

		<!-- EDITOR -->
		<section class="shell wide" data-view="editor" hidden>
			<div class="mode-tabs">
				<button type="button" class="tab active" data-mode="edit">Write</button>
				<button type="button" class="tab" data-mode="preview">Preview</button>
				<div class="device-toggle" id="device-toggle" hidden>
					<button type="button" class="dev active" data-device="desktop">
						Desktop
					</button>
					<button type="button" class="dev" data-device="mobile">Mobile</button>
				</div>
			</div>

			<div class="editor-layout">
				<div class="editor-main">
					<div id="tui-editor"></div>
					<div id="preview-pane" hidden>
						<div class="preview-frame" data-device="desktop">
							<iframe
								id="preview-iframe"
								src={`${base}/admin/preview/`}
								title="Post preview"></iframe>
						</div>
					</div>
				</div>

				<aside class="sidebar">
					<form id="post-form">
						<label class="field">
							<span class="label">Title</span>
							<input id="f-title" type="text" required maxlength="160" />
						</label>

						<label class="field">
							<span class="label">Slug</span>
							<input
								id="f-slug"
								type="text"
								required
								pattern="[a-z0-9-]+"
								placeholder="auto-from-title"
							/>
						</label>

						<label class="field">
							<span class="label">Description</span>
							<textarea id="f-desc" rows="3" required maxlength="240"></textarea>
						</label>

						<div class="field">
							<span class="label">Tags</span>
							<div class="tags">
								<label class="chip">
									<input type="checkbox" name="tag" value="ai" /> ai
								</label>
								<label class="chip">
									<input type="checkbox" name="tag" value="building" /> building
								</label>
								<label class="chip">
									<input type="checkbox" name="tag" value="marketing" /> marketing
								</label>
							</div>
						</div>

						<label class="field">
							<span class="label">Publish date</span>
							<input id="f-date" type="date" required />
						</label>

						<p id="form-error" class="err" hidden></p>

						<div class="actions">
							<button type="submit" class="primary" id="publish-btn">
								Publish
							</button>
							<span class="status" id="status"></span>
						</div>
					</form>
				</aside>
			</div>
		</section>

		<!-- SUCCESS -->
		<section class="shell narrow" data-view="success" hidden>
			<div class="card">
				<h1 id="s-title">Published.</h1>
				<p class="lead">
					Committed to <code id="s-path"></code>. GitHub Pages is rebuilding now —
					give it 30–60 seconds.
				</p>
				<div class="actions">
					<a id="s-link" class="primary" href="#" target="_blank" rel="noopener">
						Open post →
					</a>
					<a id="s-commit" class="ghost" href="#" target="_blank" rel="noopener">
						View commit
					</a>
					<button type="button" id="back-list-btn" class="ghost">
						Back to posts
					</button>
				</div>
			</div>
		</section>

		<script>
			import Editor from '@toast-ui/editor';
			import '@toast-ui/editor/dist/toastui-editor.css';
			import '@toast-ui/editor/dist/theme/toastui-editor-dark.css';
			import { marked } from 'marked';

			const REPO_OWNER = 'ObliviousWill';
			const REPO_NAME = 'field-notes';
			const BRANCH = 'main';
			const BASE = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
			const TOKEN_KEY = 'fn-admin-token';

			marked.setOptions({ gfm: true, breaks: false });

			const $ = (id) => document.getElementById(id);
			const state = {
				editing: null, // { slug, path, sha } or null for new
				mode: 'edit',
				previewReady: false,
			};
			let editor = null;
			let previewDebounce = null;

			const ghHeaders = (token, accept) => ({
				Accept: accept || 'application/vnd.github+json',
				Authorization: 'Bearer ' + token,
				'X-GitHub-Api-Version': '2022-11-28',
			});

			const getToken = () => localStorage.getItem(TOKEN_KEY);

			function show(view) {
				document.querySelectorAll('[data-view]').forEach((el) => {
					el.hidden = el.dataset.view !== view;
				});
				$('signout').hidden = view === 'login';
				$('back-to-list').hidden = !(view === 'editor' || view === 'success');
				$('page-context').textContent =
					view === 'editor'
						? state.editing
							? 'Editing: ' + state.editing.slug
							: 'New post'
						: '';
				if (view === 'editor' && editor) {
					setTimeout(() => editor.focus(), 50);
				}
			}

			function slugify(s) {
				return s
					.toLowerCase()
					.normalize('NFKD')
					.replace(/[̀-ͯ]/g, '')
					.replace(/[^\w\s-]/g, '')
					.trim()
					.replace(/\s+/g, '-')
					.replace(/-+/g, '-');
			}

			function fmtDate(iso) {
				const d = new Date(iso + 'T00:00:00');
				return d.toLocaleDateString('en-US', {
					month: 'short',
					day: '2-digit',
					year: 'numeric',
				});
			}

			function parseDate(formatted) {
				if (!formatted) return new Date().toISOString().slice(0, 10);
				const d = new Date(formatted);
				if (isNaN(d.getTime())) return new Date().toISOString().slice(0, 10);
				return d.toISOString().slice(0, 10);
			}

			function utf8ToB64(str) {
				const bytes = new TextEncoder().encode(str);
				let bin = '';
				for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
				return btoa(bin);
			}

			function b64ToUtf8(b64) {
				const bin = atob(b64.replace(/\n/g, ''));
				const bytes = new Uint8Array(bin.length);
				for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
				return new TextDecoder().decode(bytes);
			}

			async function blobToB64(blob) {
				const buf = await blob.arrayBuffer();
				const bytes = new Uint8Array(buf);
				let bin = '';
				const chunk = 0x8000;
				for (let i = 0; i < bytes.length; i += chunk) {
					bin += String.fromCharCode.apply(
						null,
						bytes.subarray(i, i + chunk),
					);
				}
				return btoa(bin);
			}

			function parseFrontmatter(md) {
				const m = md.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n+([\s\S]*)$/);
				if (!m) return { fm: {}, body: md };
				const fm = {};
				m[1].split(/\r?\n/).forEach((line) => {
					const kv = line.match(/^(\w+):\s*(.*)$/);
					if (!kv) return;
					let val = kv[2].trim();
					if (val.startsWith("'") && val.endsWith("'")) {
						val = val.slice(1, -1).replace(/''/g, "'");
					} else if (val.startsWith('"') && val.endsWith('"')) {
						val = val.slice(1, -1);
					} else if (val.startsWith('[') && val.endsWith(']')) {
						const inner = val.slice(1, -1).trim();
						val = inner
							? inner
									.split(',')
									.map((s) => s.trim().replace(/^['"]|['"]$/g, ''))
							: [];
					}
					fm[kv[1]] = val;
				});
				return { fm, body: m[2] };
			}

			function buildMarkdown(fm, body) {
				const escape = (s) => String(s).replace(/'/g, "''");
				const tagList = fm.tags && fm.tags.length
					? '[' + fm.tags.map((t) => "'" + t + "'").join(', ') + ']'
					: '[]';
				return (
					"---\n" +
					"title: '" + escape(fm.title) + "'\n" +
					"description: '" + escape(fm.description) + "'\n" +
					"pubDate: '" + fm.pubDate + "'\n" +
					"tags: " + tagList + "\n" +
					"---\n\n" +
					body.replace(/\s+$/, '') +
					'\n'
				);
			}

			async function fetchUser(token) {
				const res = await fetch('https://api.github.com/user', {
					headers: ghHeaders(token),
				});
				if (!res.ok) throw new Error('Token rejected (' + res.status + ')');
				return res.json();
			}

			async function fetchPostList(token) {
				const res = await fetch(
					'https://api.github.com/repos/' +
						REPO_OWNER +
						'/' +
						REPO_NAME +
						'/contents/src/content/blog?ref=' +
						BRANCH,
					{ headers: ghHeaders(token) },
				);
				if (!res.ok) throw new Error('Could not list posts (' + res.status + ')');
				const files = await res.json();
				return files.filter((f) => f.name.endsWith('.md'));
			}

			async function fetchPost(token, path) {
				const res = await fetch(
					'https://api.github.com/repos/' +
						REPO_OWNER +
						'/' +
						REPO_NAME +
						'/contents/' +
						path +
						'?ref=' +
						BRANCH,
					{ headers: ghHeaders(token) },
				);
				if (!res.ok) throw new Error('Could not load post (' + res.status + ')');
				return res.json();
			}

			async function putFile(token, path, content, sha, message) {
				const url =
					'https://api.github.com/repos/' +
					REPO_OWNER +
					'/' +
					REPO_NAME +
					'/contents/' +
					path;
				const body = {
					message: message,
					content: content,
					branch: BRANCH,
				};
				if (sha) body.sha = sha;
				const res = await fetch(url, {
					method: 'PUT',
					headers: {
						...ghHeaders(token),
						'Content-Type': 'application/json',
					},
					body: JSON.stringify(body),
				});
				if (!res.ok) {
					const err = await res.json().catch(() => ({}));
					throw new Error(err.message || 'GitHub API error (' + res.status + ')');
				}
				return res.json();
			}

			function ensureEditor() {
				if (editor) return editor;
				editor = new Editor({
					el: $('tui-editor'),
					height: '620px',
					initialEditType: 'wysiwyg',
					hideModeSwitch: true,
					theme: 'dark',
					usageStatistics: false,
					placeholder: 'Write your post…',
					toolbarItems: [
						['heading', 'bold', 'italic', 'strike'],
						['hr', 'quote'],
						['ul', 'ol'],
						['link', 'image'],
					],
					hooks: {
						addImageBlobHook: async (blob, callback) => {
							try {
								const token = getToken();
								if (!token) throw new Error('Not signed in');
								const ext =
									(blob.type && blob.type.split('/')[1]) ||
									(blob.name && blob.name.split('.').pop()) ||
									'png';
								const cleanName = (blob.name || 'image')
									.toLowerCase()
									.replace(/\.[^.]+$/, '')
									.replace(/[^a-z0-9-]+/g, '-')
									.replace(/-+/g, '-')
									.slice(0, 40);
								const filename =
									Date.now() + '-' + (cleanName || 'image') + '.' + ext;
								const path = 'public/blog/images/' + filename;
								const b64 = await blobToB64(blob);
								await putFile(token, path, b64, null, 'Upload image: ' + filename);
								const url = BASE + '/blog/images/' + filename;
								callback(url, filename);
							} catch (err) {
								alert('Image upload failed: ' + err.message);
							}
						},
					},
				});
				editor.on('change', () => {
					schedulePreview();
				});
				return editor;
			}

			function gatherForm() {
				const tags = Array.from(
					document.querySelectorAll('input[name="tag"]:checked'),
				).map((c) => c.value);
				return {
					title: $('f-title').value.trim(),
					slug: slugify($('f-slug').value),
					description: $('f-desc').value.trim(),
					date: $('f-date').value,
					tags: tags,
					body: editor ? editor.getMarkdown() : '',
				};
			}

			function populateForm(fm, body) {
				$('f-title').value = fm.title || '';
				$('f-slug').value = state.editing ? state.editing.slug : '';
				$('f-slug').dataset.touched = '1';
				$('f-desc').value = fm.description || '';
				$('f-date').value = parseDate(fm.pubDate);
				const tags = Array.isArray(fm.tags) ? fm.tags : [];
				document.querySelectorAll('input[name="tag"]').forEach((c) => {
					c.checked = tags.includes(c.value);
				});
				ensureEditor();
				editor.setMarkdown(body || '');
				schedulePreview();
			}

			function resetForm() {
				$('post-form').reset();
				$('f-slug').dataset.touched = '';
				$('f-date').value = new Date().toISOString().slice(0, 10);
				ensureEditor();
				editor.setMarkdown('');
				$('form-error').hidden = true;
			}

			function schedulePreview() {
				if (!state.previewReady) return;
				clearTimeout(previewDebounce);
				previewDebounce = setTimeout(sendPreview, 220);
			}

			function sendPreview() {
				const data = gatherForm();
				const html = marked.parse(data.body || '');
				const dateDisplay = data.date ? fmtDate(data.date) : '';
				const frame = $('preview-iframe');
				if (!frame || !frame.contentWindow) return;
				frame.contentWindow.postMessage(
					{
						type: 'preview-update',
						title: data.title,
						dek: data.description,
						tags: data.tags,
						date: dateDisplay,
						html: html,
					},
					'*',
				);
			}

			function setMode(mode) {
				state.mode = mode;
				document.querySelectorAll('.mode-tabs .tab').forEach((t) => {
					t.classList.toggle('active', t.dataset.mode === mode);
				});
				$('tui-editor').hidden = mode !== 'edit';
				$('preview-pane').hidden = mode !== 'preview';
				$('device-toggle').hidden = mode !== 'preview';
				if (mode === 'preview') sendPreview();
			}

			function setDevice(device) {
				document.querySelectorAll('.device-toggle .dev').forEach((d) => {
					d.classList.toggle('active', d.dataset.device === device);
				});
				document
					.querySelector('.preview-frame')
					.setAttribute('data-device', device);
			}

			async function showList(silent) {
				show('list');
				const token = getToken();
				if (!token) return show('login');
				const list = $('post-list');
				const meta = $('list-meta');
				if (!silent) {
					list.innerHTML = '';
					meta.textContent = 'Loading…';
				}
				try {
					const files = await fetchPostList(token);
					const cards = await Promise.all(
						files.map(async (f) => {
							try {
								const data = await fetchPost(token, f.path);
								const md = b64ToUtf8(data.content);
								const { fm } = parseFrontmatter(md);
								return {
									slug: f.name.replace(/\.md$/, ''),
									path: f.path,
									sha: data.sha,
									title: fm.title || f.name,
									description: fm.description || '',
									pubDate: fm.pubDate || '',
									tags: Array.isArray(fm.tags) ? fm.tags : [],
								};
							} catch {
								return {
									slug: f.name.replace(/\.md$/, ''),
									path: f.path,
									sha: f.sha,
									title: f.name,
									description: '',
									pubDate: '',
									tags: [],
								};
							}
						}),
					);
					cards.sort((a, b) => {
						const da = new Date(a.pubDate).getTime() || 0;
						const db = new Date(b.pubDate).getTime() || 0;
						return db - da;
					});
					meta.textContent = cards.length + (cards.length === 1 ? ' post' : ' posts');
					list.innerHTML = '';
					cards.forEach((c) => {
						const item = document.createElement('article');
						item.className = 'post-item';
						item.innerHTML =
							'<div class="post-item-meta">' +
							c.tags.map((t) => '<span class="t-chip t-' + t + '">' + t + '</span>').join('') +
							'<span class="t-date">' + (c.pubDate || '') + '</span>' +
							'</div>' +
							'<h3 class="post-item-title">' + escapeHtml(c.title) + '</h3>' +
							'<p class="post-item-desc">' + escapeHtml(c.description) + '</p>' +
							'<div class="post-item-actions">' +
							'<button class="ghost small" data-edit>Edit</button>' +
							'<a class="ghost small" href="' + BASE + '/blog/' + c.slug + '/" target="_blank" rel="noopener">View ↗</a>' +
							'</div>';
						item.querySelector('[data-edit]').addEventListener('click', () =>
							openEditor(c),
						);
						list.appendChild(item);
					});
				} catch (err) {
					meta.textContent = '';
					list.innerHTML =
						'<p class="err">' + escapeHtml(err.message) + '</p>';
				}
			}

			function escapeHtml(s) {
				return String(s || '')
					.replace(/&/g, '&amp;')
					.replace(/</g, '&lt;')
					.replace(/>/g, '&gt;')
					.replace(/"/g, '&quot;');
			}

			function openEditor(card) {
				state.editing = card
					? { slug: card.slug, path: card.path, sha: card.sha }
					: null;
				setMode('edit');
				if (card) {
					show('editor');
					ensureEditor();
					(async () => {
						try {
							const token = getToken();
							const data = await fetchPost(token, card.path);
							state.editing.sha = data.sha;
							const md = b64ToUtf8(data.content);
							const { fm, body } = parseFrontmatter(md);
							populateForm(fm, body);
							$('page-context').textContent = 'Editing: ' + card.slug;
						} catch (err) {
							$('form-error').textContent = err.message;
							$('form-error').hidden = false;
						}
					})();
				} else {
					show('editor');
					resetForm();
				}
			}

			// Boot
			(function boot() {
				const token = getToken();
				if (token) {
					fetchUser(token)
						.then(() => showList())
						.catch((err) => {
							localStorage.removeItem(TOKEN_KEY);
							$('login-error').textContent = err.message;
							$('login-error').hidden = false;
							show('login');
						});
				} else {
					show('login');
				}
			})();

			// Login form
			$('login-form').addEventListener('submit', async (e) => {
				e.preventDefault();
				$('login-error').hidden = true;
				const token = $('token-input').value.trim();
				if (!token) return;
				try {
					await fetchUser(token);
					localStorage.setItem(TOKEN_KEY, token);
					await showList();
				} catch (err) {
					$('login-error').textContent = err.message;
					$('login-error').hidden = false;
				}
			});

			$('signout').addEventListener('click', () => {
				localStorage.removeItem(TOKEN_KEY);
				$('token-input').value = '';
				show('login');
			});

			$('back-to-list').addEventListener('click', () => showList());
			$('new-post-btn').addEventListener('click', () => openEditor(null));
			$('back-list-btn').addEventListener('click', () => showList());

			// Mode tabs
			document.querySelectorAll('.mode-tabs .tab').forEach((t) => {
				t.addEventListener('click', () => setMode(t.dataset.mode));
			});
			document.querySelectorAll('.device-toggle .dev').forEach((d) => {
				d.addEventListener('click', () => setDevice(d.dataset.device));
			});

			// Auto-slug
			$('f-title').addEventListener('input', (e) => {
				const slug = $('f-slug');
				if (!slug.dataset.touched) {
					slug.value = slugify(e.target.value);
				}
				schedulePreview();
			});
			$('f-slug').addEventListener('input', (e) => {
				e.target.dataset.touched = '1';
			});
			$('f-desc').addEventListener('input', schedulePreview);
			$('f-date').addEventListener('input', schedulePreview);
			document.querySelectorAll('input[name="tag"]').forEach((c) => {
				c.addEventListener('change', schedulePreview);
			});

			// Preview ready handshake
			window.addEventListener('message', (e) => {
				if (e.data && e.data.type === 'preview-ready') {
					state.previewReady = true;
					schedulePreview();
				}
			});

			// Publish
			$('post-form').addEventListener('submit', async (e) => {
				e.preventDefault();
				$('form-error').hidden = true;
				const token = getToken();
				if (!token) return show('login');

				const data = gatherForm();
				if (!data.title || !data.slug || !data.description || !data.date || !data.body) {
					$('form-error').textContent = 'All fields are required.';
					$('form-error').hidden = false;
					return;
				}

				const fm = {
					title: data.title,
					description: data.description,
					pubDate: fmtDate(data.date),
					tags: data.tags,
				};
				const fileContent = buildMarkdown(fm, data.body);
				const path = 'src/content/blog/' + data.slug + '.md';
				const btn = $('publish-btn');
				const status = $('status');
				btn.disabled = true;
				status.textContent = state.editing ? 'Updating…' : 'Publishing…';

				try {
					const message = state.editing
						? 'Update post: ' + data.title
						: 'Add post: ' + data.title;
					const sha = state.editing && state.editing.path === path
						? state.editing.sha
						: null;
					const result = await putFile(
						token,
						path,
						utf8ToB64(fileContent),
						sha,
						message,
					);
					$('s-title').textContent = state.editing ? 'Updated.' : 'Published.';
					$('s-path').textContent = path;
					$('s-link').href = BASE + '/blog/' + data.slug + '/';
					$('s-commit').href =
						result.commit && result.commit.html_url
							? result.commit.html_url
							: '#';
					show('success');
					status.textContent = '';
					btn.disabled = false;
					state.editing = null;
				} catch (err) {
					$('form-error').textContent = err.message;
					$('form-error').hidden = false;
					status.textContent = '';
					btn.disabled = false;
				}
			});
		</script>

