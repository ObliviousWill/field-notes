---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { readingTimeMinutes } from '../../utils/readingTime';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			nextPost: i > 0 ? posts[i - 1] : i < posts.length - 1 ? posts[i + 1] : null,
		},
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
	nextPost: CollectionEntry<'blog'> | null;
}

const { post, nextPost } = Astro.props;
const { Content } = await render(post);
const readingTime = readingTimeMinutes(post.body);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImageUrl = `${base}/og/${post.id}.png`;
---

<BlogPost
	{...post.data}
	readingTime={readingTime}
	nextPost={nextPost}
	ogImageUrl={ogImageUrl}
>
	<Content />
</BlogPost>
