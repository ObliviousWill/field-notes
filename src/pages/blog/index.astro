---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import PageTitle from '../../components/PageTitle.astro';
import PostRow from '../../components/PostRow.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rssUrl = `${base}/rss.xml`;
const slugList = JSON.stringify(posts.map((p) => p.id));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Blog · ${SITE_TITLE}`}
			description="What I'm working through, in the open. Newest first."
		/>
	</head>
	<body>
		<Header current="blog" />
		<main>
			<PageTitle
				title="Blog"
				count={posts.length}
				countLabel="posts"
				subtitle="What I'm working through, in the open. Newest first."
			>
				<a slot="side-link" class="fn-link" href={rssUrl}>RSS ↗</a>
			</PageTitle>

			<div class="legend">
				<span class="dot" aria-hidden="true"></span>
				<span>= unread · <span data-unread-count>{posts.length}</span> of {posts.length}</span>
				<button type="button" class="mark-all">mark all unread</button>
			</div>

			<hr />

			<ol class="posts">
				{posts.map((post) => <PostRow post={post} />)}
			</ol>

			<NewsletterBlock />
		</main>
		<Footer />
		<script is:inline define:vars={{ slugList }}>
			const slugs = JSON.parse(slugList);
			const READ_KEY = 'fn:read-posts';
			const updateUnreadCount = () => {
				const countEl = document.querySelector('[data-unread-count]');
				if (!countEl) return;
				let read = [];
				try {
					read = JSON.parse(localStorage.getItem(READ_KEY) || '[]');
				} catch {
					read = [];
				}
				const unread = slugs.filter((s) => !read.includes(s)).length;
				countEl.textContent = String(unread);
			};
			const markAll = () => {
				localStorage.setItem(READ_KEY, JSON.stringify([]));
				document.querySelectorAll('[data-slug][data-unread]').forEach((el) => {
					el.setAttribute('data-unread', 'true');
					el.setAttribute('aria-label', 'Mark as read');
					el.setAttribute('title', 'Unread — click to mark read');
				});
				updateUnreadCount();
			};
			const init = () => {
				updateUnreadCount();
				const button = document.querySelector('.mark-all');
				button?.addEventListener('click', markAll);
				document.addEventListener('click', (event) => {
					const target = event.target.closest('[data-slug][data-unread]');
					if (target) updateUnreadCount();
				});
			};
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', init);
			} else {
				init();
			}
		</script>
	</body>
</html>
<style>
	.legend {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-top: 14px;
		font-size: 12px;
		color: var(--muted-soft);
		font-family: var(--font-atkinson);
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent);
		display: inline-block;
		box-shadow: 0 0 0 1px var(--accent);
	}
	.mark-all {
		margin-left: auto;
		background: transparent;
		border: 0;
		color: var(--accent-ink);
		cursor: pointer;
		font-size: 12px;
		padding: 0;
		font-family: var(--font-atkinson);
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 1px;
	}
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
