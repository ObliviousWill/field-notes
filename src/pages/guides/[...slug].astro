---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { readingTimeMinutes } from '../../utils/readingTime';

export async function getStaticPaths() {
	const guides = (await getCollection('guides')).sort((a, b) => a.data.step - b.data.step);
	return guides.map((guide, i) => ({
		params: { slug: guide.id },
		props: { guide, next: guides[i + 1] ?? null, count: guides.length },
	}));
}

interface Props {
	guide: CollectionEntry<'guides'>;
	next: CollectionEntry<'guides'> | null;
	count: number;
}

const { guide, next, count } = Astro.props;
const { Content } = await render(guide);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BlogPost
	{...guide.data}
	section="guides"
	stepCount={count}
	readingTime={readingTimeMinutes(guide.body)}
	ogImageUrl={`${base}/og/guides/${guide.id}.png`}
	nextGuide={next
		? {
				href: `${base}/guides/${next.id}/`,
				title: next.data.title,
				description: next.data.description,
			}
		: null}
>
	<Content />
</BlogPost>
