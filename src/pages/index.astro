---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getUpdatesForProject, updateSlug } from '../utils/projects';
import { readingTimeMinutes } from '../utils/readingTime';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5)
	.map((post) => ({ ...post, readingTime: readingTimeMinutes(post.body) }));

const buildingProjects = (await getCollection('projects'))
	.filter((p) => p.data.status === 'building')
	.sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());

const building = (
	await Promise.all(
		buildingProjects.map(async (project) => {
			const updates = await getUpdatesForProject(project.id);
			return { project, latestUpdate: updates[0] };
		}),
	)
).slice(0, 2);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 3em 0 2em;
				border-bottom: 1px solid rgba(var(--text), 12%);
				margin-bottom: 2.5em;
			}
			.hero h1 {
				font-size: 2.441em;
				margin: 0 0 0.4em;
				line-height: 1.1;
			}
			.hero p {
				font-size: 1.125em;
				margin: 0 0 1em;
				color: rgb(var(--text));
				max-width: 38em;
			}
			.hero .meta {
				color: rgb(var(--text-muted));
				font-size: 0.95em;
				margin: 0;
			}
			.section-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin: 0 0 1em;
			}
			.section-heading h2 {
				font-size: 1.563em;
				margin: 0;
			}
			.section-heading a {
				font-size: 0.95em;
			}
			.posts {
				list-style: none;
				margin: 0 0 3em;
				padding: 0;
			}
			.posts li {
				padding: 1em 0;
				border-bottom: 1px solid rgba(var(--text), 10%);
			}
			.posts li:last-child {
				border-bottom: none;
			}
			.posts a {
				display: flex;
				flex-direction: column;
				gap: 0.2em;
				text-decoration: none;
				color: rgb(var(--text));
			}
			.post-title {
				font-size: 1.25em;
				font-weight: 700;
				margin: 0;
			}
			.post-title-text {
				background-image: linear-gradient(var(--accent), var(--accent));
				background-position: 0 100%;
				background-repeat: no-repeat;
				background-size: 100% 0;
				-webkit-box-decoration-break: clone;
				box-decoration-break: clone;
				border-radius: 1px;
				transition: background-size 0.2s ease;
			}
			.posts a:hover .post-title-text {
				background-size: 100% 100%;
			}
			@media (prefers-reduced-motion: reduce) {
				.post-title-text {
					transition: none;
				}
			}
			.post-date {
				color: rgb(var(--text-muted));
				font-size: 0.9em;
				margin: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				align-items: baseline;
			}
			.post-date .sep {
				opacity: 0.5;
			}
			.empty {
				color: rgb(var(--text-muted));
				font-style: italic;
				padding: 1em 0;
			}
			.building {
				list-style: none;
				margin: 0 0 3em;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1em;
			}
			.building-card {
				display: block;
				padding: 1.25em 1.25em;
				background: var(--bg-soft);
				border: 1px solid rgba(var(--text), 8%);
				border-radius: 12px;
				text-decoration: none;
				color: inherit;
			}
			.building-card:hover {
				border-color: var(--accent);
			}
			.building-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				flex-wrap: wrap;
				margin-bottom: 0.3em;
			}
			.building-title {
				margin: 0;
				font-size: 1.25em;
				font-weight: 700;
				color: rgb(var(--text));
			}
			.building-summary {
				margin: 0.2em 0 0.6em;
				color: rgb(var(--text));
			}
			.building-update {
				margin: 0;
				font-size: 0.9em;
				color: rgb(var(--text-muted));
			}
			.building-update strong {
				color: rgb(var(--text));
				font-weight: 600;
			}
			@media (max-width: 720px) {
				.hero h1 {
					font-size: 1.953em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Field Notes</h1>
				<p>
					Notes from the field on marketing, building, and AI in practice, written in the open
					by someone doing the work, not watching it.
				</p>
				<p class="meta">
					New posts roughly weekly. <a href={`${base}/about/`}>More about this site →</a>
				</p>
			</section>

			{
				building.length > 0 && (
					<section>
						<div class="section-heading">
							<h2>Currently building</h2>
							<a href={`${base}/projects/`}>All projects →</a>
						</div>
						<ul class="building">
							{building.map(({ project, latestUpdate }) => (
								<li>
									<a class="building-card" href={`${base}/projects/${project.id}/`}>
										<div class="building-head">
											<p class="building-title">{project.data.title}</p>
											<span class={`status status-${project.data.status}`}>
												{project.data.status}
											</span>
										</div>
										<p class="building-summary">{project.data.summary}</p>
										{latestUpdate && (
											<p class="building-update">
												Latest: <strong>{latestUpdate.data.title}</strong>{' '}
												<span>
													(<FormattedDate date={latestUpdate.data.pubDate} />)
												</span>
											</p>
										)}
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			<section>
				<div class="section-heading">
					<h2>Recent posts</h2>
					<a href={`${base}/blog/`}>All posts →</a>
				</div>
				{
					recentPosts.length === 0 ? (
						<p class="empty">First post landing soon.</p>
					) : (
						<ul class="posts">
							{recentPosts.map((post) => (
								<li>
									<a href={`${base}/blog/${post.id}/`}>
										<p class="post-title"><span class="post-title-text">{post.data.title}</span></p>
										<p class="post-date">
											<FormattedDate date={post.data.pubDate} />
											<span class="sep">·</span>
											<span>{post.readingTime} min read</span>
										</p>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
