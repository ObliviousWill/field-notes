---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import PostRow from '../components/PostRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const buildingProjects = (await getCollection('projects'))
	.filter((p) => p.data.status === 'building')
	.sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf())
	.slice(0, 1);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header current="home" />
		<main>
			<section class="hero">
				<p class="kicker">A working notebook</p>
				<h1>Field Notes</h1>
				<p class="tagline">{SITE_DESCRIPTION}</p>
				<p class="lede">
					<span>New posts roughly weekly.</span>
					<a class="fn-link" href={`${base}/about/`}>More about this site →</a>
				</p>
			</section>

			<hr />

			{
				buildingProjects.length > 0 && (
					<section>
						<SectionHeading title="Currently building" top={false}>
							<a slot="side-link" class="fn-link" href={`${base}/projects/`}>
								All projects →
							</a>
						</SectionHeading>
						<div class="card-stack">
							{buildingProjects.map((project) => (
								<ProjectCard project={project} />
							))}
						</div>
					</section>
				)
			}

			<section class="recent">
				<SectionHeading title="Recent posts">
					<a slot="side-link" class="fn-link" href={`${base}/blog/`}>All posts →</a>
				</SectionHeading>
				{
					recentPosts.length === 0 ? (
						<p class="empty">First post landing soon.</p>
					) : (
						<ol class="posts">
							{recentPosts.map((post) => (
								<PostRow post={post} compact />
							))}
						</ol>
					)
				}
			</section>

			<NewsletterBlock />
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero h1 {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 96px;
		margin: 0;
		line-height: 0.98;
		letter-spacing: -0.025em;
	}
	.hero .kicker {
		margin: 0 0 12px;
	}
	.tagline {
		color: rgb(var(--text-muted));
		font-size: 22px;
		line-height: 1.45;
		margin: 24px 0 28px;
		max-width: 580px;
	}
	.lede {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		color: rgb(var(--text-muted));
		font-size: 15px;
		margin: 0;
	}
	.card-stack {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.empty {
		color: rgb(var(--text-muted));
		font-style: italic;
		padding: 16px 0;
	}
	.recent {
		margin-top: 0;
	}
	@media (max-width: 720px) {
		.hero h1 {
			font-size: 54px;
		}
		.tagline {
			font-size: 18px;
			margin: 18px 0 22px;
		}
		.card-stack {
			gap: 14px;
		}
	}
</style>
