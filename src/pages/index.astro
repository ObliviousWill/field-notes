---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 3em 0 2em;
				border-bottom: 1px solid rgba(var(--text), 12%);
				margin-bottom: 2.5em;
			}
			.hero h1 {
				font-size: 2.441em;
				margin: 0 0 0.4em;
				line-height: 1.1;
			}
			.hero p {
				font-size: 1.125em;
				margin: 0 0 1em;
				color: rgb(var(--text));
				max-width: 38em;
			}
			.hero .meta {
				color: rgb(var(--text-muted));
				font-size: 0.95em;
				margin: 0;
			}
			.section-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin: 0 0 1em;
			}
			.section-heading h2 {
				font-size: 1.563em;
				margin: 0;
			}
			.section-heading a {
				font-size: 0.95em;
			}
			.posts {
				list-style: none;
				margin: 0 0 3em;
				padding: 0;
			}
			.posts li {
				padding: 1em 0;
				border-bottom: 1px solid rgba(var(--text), 10%);
			}
			.posts li:last-child {
				border-bottom: none;
			}
			.posts a {
				display: flex;
				flex-direction: column;
				gap: 0.2em;
				text-decoration: none;
				color: rgb(var(--text));
			}
			.posts a:hover .post-title {
				text-decoration: underline;
				text-decoration-color: var(--accent);
				text-decoration-thickness: 2px;
				text-underline-offset: 3px;
			}
			.post-title {
				font-size: 1.25em;
				font-weight: 700;
				margin: 0;
			}
			.post-date {
				color: rgb(var(--text-muted));
				font-size: 0.9em;
				margin: 0;
			}
			.empty {
				color: rgb(var(--text-muted));
				font-style: italic;
				padding: 1em 0;
			}
			@media (max-width: 720px) {
				.hero h1 {
					font-size: 1.953em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Field Notes</h1>
				<p>
					Notes from the field on marketing, building, and AI in practice — written in the open
					by someone doing the work, not watching it.
				</p>
				<p class="meta">
					New posts roughly weekly. <a href={`${base}/about/`}>More about this site →</a>
				</p>
			</section>

			<section>
				<div class="section-heading">
					<h2>Recent posts</h2>
					<a href={`${base}/blog/`}>All posts →</a>
				</div>
				{
					recentPosts.length === 0 ? (
						<p class="empty">First post landing soon.</p>
					) : (
						<ul class="posts">
							{recentPosts.map((post) => (
								<li>
									<a href={`${base}/blog/${post.id}/`}>
										<p class="post-title">{post.data.title}</p>
										<p class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
