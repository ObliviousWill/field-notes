---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import PostRow from '../components/PostRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import IdeaCard from '../components/ideas/IdeaCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const doors = [
	{
		tab: "I'm new to AI",
		title: 'Start with the guides',
		body: 'Short, plain-English guides to using Claude well. One sitting each, with exercises to try.',
		go: 'Start guide 1',
		href: '/guides/what-claude-is-and-how-to-start/',
	},
	{
		tab: 'I run a small business',
		title: 'Steal an idea',
		body: 'Quizzes, calculators and games that bring in customers. Play one, then copy the prompt.',
		go: 'See the ideas',
		href: '/ideas/',
	},
	{
		tab: "Show me what's possible",
		title: 'See what I build',
		body: "Things I've built with Claude, from reports that write themselves to 3D demos.",
		go: 'Browse projects',
		href: '/projects/',
	},
];

const featuredIdeas = (await getCollection('ideas'))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 4);

const recentProjects = (await getCollection('projects'))
	.sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf())
	.slice(0, 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header current="home" />
		<main>
			<section class="hero">
				<p class="kicker">A working notebook by Will</p>
				<h1>Field Notes</h1>
				<p class="tagline">
					What I build with AI, and what I learn doing it. In <span class="hl">plain English</span>,
					for people who aren't developers.
				</p>
				<p class="hand scribble" aria-hidden="true">So, where do you want to start? <span>↓</span></p>
			</section>

			<nav class="doors" aria-label="Where to start">
				{
					doors.map((d, i) => (
						<a class={`door door-${i + 1}`} href={`${base}${d.href}`}>
							<span class="tab hand">{d.tab}</span>
							<span class="door-title">{d.title}</span>
							<span class="door-body">{d.body}</span>
							<span class="door-go">{d.go} →</span>
						</a>
					))
				}
			</nav>

			{
				featuredIdeas.length > 0 && (
					<section class="ideas">
						<SectionHeading title="Ideas to steal" top={false}>
							<a slot="side-link" class="fn-link" href={`${base}/ideas/`}>
								All ideas →
							</a>
						</SectionHeading>
						<p class="ideas-line">Quizzes, calculators and games that bring in customers. Play them, then build your own.</p>
						<ul class="idea-grid">
							{featuredIdeas.map((idea) => (
								<li>
									<IdeaCard idea={idea} />
								</li>
							))}
						</ul>
					</section>
				)
			}

			{
				recentProjects.length > 0 && (
					<section>
						<SectionHeading title="Recent projects" top={false}>
							<a slot="side-link" class="fn-link" href={`${base}/projects/`}>
								All projects →
							</a>
						</SectionHeading>
						<div class="card-stack">
							{recentProjects.map((project) => (
								<ProjectCard project={project} />
							))}
						</div>
					</section>
				)
			}

			<section class="recent">
				<SectionHeading title="Recent posts">
					<a slot="side-link" class="fn-link" href={`${base}/blog/`}>All posts →</a>
				</SectionHeading>
				{
					recentPosts.length === 0 ? (
						<p class="empty">First post landing soon.</p>
					) : (
						<ol class="posts">
							{recentPosts.map((post) => (
								<PostRow post={post} compact />
							))}
						</ol>
					)
				}
			</section>

			<NewsletterBlock />
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero h1 {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 96px;
		margin: 0;
		line-height: 0.98;
		letter-spacing: -0.025em;
	}
	.hero .kicker {
		margin: 0 0 12px;
	}
	.tagline {
		color: rgb(var(--text-muted));
		font-size: 22px;
		line-height: 1.45;
		margin: 24px 0 28px;
		max-width: 580px;
	}
	.lede {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		color: rgb(var(--text-muted));
		font-size: 15px;
		margin: 0;
	}
	.card-stack {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.empty {
		color: rgb(var(--text-muted));
		font-style: italic;
		padding: 16px 0;
	}
	.recent {
		margin-top: 0;
	}
	@media (max-width: 720px) {
		.hero h1 {
			font-size: 54px;
		}
		.tagline {
			font-size: 18px;
			margin: 18px 0 22px;
		}
		.card-stack {
			gap: 14px;
		}
	}
	.start {
		margin-bottom: 48px;
	}
	.start-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
	}
	.start-list a {
		display: flex;
		align-items: baseline;
		gap: 12px;
		height: 100%;
		box-sizing: border-box;
		padding: 16px 18px;
		background: var(--bg-soft);
		border: 1px solid var(--hairline-soft);
		border-radius: 8px;
		text-decoration: none;
		background-image: none;
		color: rgb(var(--text));
	}
	.start-list a:hover {
		border-color: rgba(255, 177, 98, 0.7);
		background-size: 0;
	}
	.start-num {
		font-family: var(--font-display);
		font-size: 26px;
		line-height: 1;
		color: var(--accent);
	}
	.start-title {
		font-weight: 700;
		font-size: 16px;
		line-height: 1.3;
	}
	@media (max-width: 720px) {
		.start-list {
			grid-template-columns: 1fr;
		}
	}
	.ideas {
		margin-bottom: 48px;
	}
	.ideas-line {
		margin: -4px 0 14px;
		color: rgb(var(--text-muted));
		font-size: 15px;
	}
	.idea-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
	}
	.idea-grid li {
		margin: 0;
	}
	@media (max-width: 720px) {
		.idea-grid {
			display: flex;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			margin: 0 -16px;
			padding: 4px 16px 12px;
			scrollbar-width: none;
		}
		.idea-grid li {
			flex: 0 0 78%;
			scroll-snap-align: start;
		}
	}
	.scribble {
		margin: 22px 0 0;
		font-size: 30px;
		color: var(--ink);
		transform: rotate(-1.5deg);
		transform-origin: left;
	}
	.scribble span {
		display: inline-block;
		animation: nudge 1.6s ease-in-out infinite;
	}
	@keyframes nudge {
		50% {
			transform: translateY(5px);
		}
	}
	.doors {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
		margin: 34px 0 56px;
	}
	.door {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 34px 18px 18px;
		background: var(--bg-soft);
		border: 1px solid var(--hairline);
		border-radius: 4px 10px 10px 10px;
		box-shadow: 0 1px 0 rgba(0, 0, 0, 0.03), 0 8px 18px -10px rgba(44, 59, 77, 0.35);
		text-decoration: none;
		background-image: none;
		color: rgb(var(--text));
		transition: transform 200ms ease, box-shadow 200ms ease;
	}
	.door:nth-child(1) {
		transform: rotate(-1deg);
		--tab: var(--kraft);
	}
	.door:nth-child(2) {
		transform: rotate(0.6deg) translateY(6px);
		--tab: #b9cde4;
	}
	.door:nth-child(3) {
		transform: rotate(-0.4deg);
		--tab: #efb8a8;
	}
	.door:hover,
	.door:focus-visible {
		transform: rotate(0deg) translateY(-4px);
		box-shadow: 0 1px 0 rgba(0, 0, 0, 0.03), 0 16px 26px -12px rgba(44, 59, 77, 0.45);
		background-size: 0;
	}
	.tab {
		position: absolute;
		top: -18px;
		left: 12px;
		padding: 4px 14px 2px;
		background: var(--tab);
		border-radius: 8px 8px 0 0;
		font-size: 21px;
		line-height: 1.1;
		color: #2b2418;
	}
	.door-title {
		font-family: var(--font-display);
		font-size: 25px;
		line-height: 1.1;
	}
	.door-body {
		font-size: 15px;
		line-height: 1.45;
		color: rgb(var(--text-muted));
		flex: 1;
	}
	.door-go {
		font-size: 14px;
		font-weight: 700;
		color: var(--accent-ink);
	}
	@media (max-width: 720px) {
		.doors {
			grid-template-columns: 1fr;
			gap: 30px;
			margin-top: 34px;
		}
		.scribble {
			font-size: 26px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.scribble span {
			animation: none;
		}
		.door {
			transition: none;
		}
	}
</style>
