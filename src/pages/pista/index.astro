          '<div class="grow"><div class="nm">' + t.map(x => esc(pname(x))).join(' & ') + '</div></div></div>';
      });
      h += '</div>';
    } else {
      h += '<div class="panel"><div class="field" style="margin-top:0"><label class="eyebrow">Points per round</label><div class="segs">';
      [16, 21, 24, 32].forEach(v => h += '<button class="seg ' + (d.points === v ? 'on' : '') + '" data-a="set-points" data-v="' + v + '">' + v + '</button>');
      h += '</div><div class="stepper" style="margin-top:8px"><button data-a="pts" data-v="-1">&#8722;</button>' +
        '<span class="val">' + d.points + '</span><button data-a="pts" data-v="1">+</button></div>' +
        '<div class="hint">Every point you win counts towards your own total.</div></div>';
      h += '<div class="field"><label class="eyebrow">Rounds</label><div class="stepper">' +
        '<button data-a="rds" data-v="-1">&#8722;</button><span class="val">' + d.rounds + '</span><button data-a="rds" data-v="1">+</button></div>' +
        '<div class="hint">' + (d.format === 'mexicano' ? 'Round one is drawn at random. After that the table sets the pairings.' :
          'Suggested for ' + d.ids.length + ' players on ' + d.courts + ' court' + (d.courts > 1 ? 's' : '') + '.') + '</div></div></div>';
    }
    h += '<div class="btn-row stick"><button class="btn primary" data-a="create-event">Start ' + esc(d.name || 'event') + '</button></div>';
  }
  return h;
}
function pairUp(d) {
  if (!d.teams || d.teams.flat().length !== d.ids.length) {
    const s = shuffle(d.ids); d.teams = [];
    for (let i = 0; i < s.length; i += 2) d.teams.push([s[i], s[i + 1]]);
  }
  return d.teams;
}

/* ── live event ── */
function vEvent() {
  const ev = S.events.find(e => e.id === view.id);
  if (!ev) return vHome();
  const total = ev.rounds.length;
  let idx = view.r;
  if (idx == null) { idx = Math.min(evProgress(ev), total - 1); view.r = idx; }
  const r = ev.rounds[idx];

  const tab = view.tab === 'table' ? 'table' : 'round';
  let h = '<div class="evbar"><button class="ebk" data-a="back" aria-label="Back">&#8592;</button>' +
    '<div class="ebt"><div class="ebn">' + esc(ev.name) + '</div><div class="ebm">' + esc(FORMATS[ev.format].n) + ' &middot; ' +
    (ev.status === 'live' ? 'Round ' + (idx + 1) + ' of ' + roundsPlanned(ev) : fmtDate(ev.created)) + '</div></div>' +
    (ev.status === 'live' ? '<span class="pill ball">Live</span>' : '<span class="pill">Finished</span>') +
    '<button class="icon-btn" data-a="event-menu" aria-label="Event options" aria-haspopup="dialog">&#8943;</button></div>';

  if (ev.status !== 'live') {
    const w = winnerOf(ev);
    if (w) h += '<div class="champ">' + (w.id ? av(w.id, true) : '') +
      '<div><div class="cl">Winner</div><div class="cn">' + esc(w.who) + '</div>' +
      '<div class="cs">' + w.pts + ' points &middot; ' + (w.diff > 0 ? '+' : '') + w.diff + ' difference &middot; ' +
      evProgress(ev) + ' rounds</div></div></div>';
  }

  h += '<div class="segs evtabs" role="tablist">' +
    '<button class="seg ' + (tab === 'round' ? 'on' : '') + '" data-a="ev-tab" data-v="round" role="tab" aria-selected="' + (tab === 'round') + '">Round</button>' +
    '<button class="seg ' + (tab === 'table' ? 'on' : '') + '" data-a="ev-tab" data-v="table" role="tab" aria-selected="' + (tab === 'table') + '">Table</button></div>';
  h += '<div class="split" data-tab="' + tab + '"><div class="colA">';

  /* round strip */
  h += '<div class="court-label" style="margin-bottom:7px"><span class="eyebrow">Rounds</span>' +
    '<span class="eyebrow">' + evProgress(ev) + ' of ' + roundsPlanned(ev) + ' played</span></div>';
  h += '<div style="display:flex;gap:6px;overflow-x:auto;padding:2px 0 12px">';
  ev.rounds.forEach((rr, i) => {
    const dn = roundDone(rr);
    h += '<button class="pill ' + (dn ? 'ball' : '') + '" data-a="goto-round" data-i="' + i + '"' +
      (i === idx ? ' aria-current="true"' : '') +
      ' aria-label="Round ' + (i + 1) + (dn ? ', scored' : ', not scored yet') + '" style="flex:none;' +
      (i === idx ? 'background:rgba(217,230,79,.16);border-color:var(--ball);color:var(--ball)' : '') + '">R' + (i + 1) + (dn ? ' \u2713' : '') + '</button>';
  });
  h += '</div>';

  /* courts */
  h += '<div class="courts">';
  r.matches.forEach((m, mi) => {
    const scored = m.sa != null && m.sb != null;
    h += '<div class="court-wrap"><div class="court-label"><span class="eyebrow">Court ' + m.court + '</span>' +
      (scored ? '<span class="eyebrow" style="color:var(--ball)">Scored</span>' : '') + '</div>' +
      '<div class="court ' + (scored ? 'done' : '') + '">' +
      '<div class="side top ' + (scored && m.sa > m.sb ? 'win' : '') + '"><div class="team"><div class="nm">' + teamName(m.a) + '</div></div></div>' +
      '<div class="net"><button class="netscore ' + (scored ? '' : 'empty') + '" data-a="score" data-r="' + idx + '" data-m="' + mi + '"' +
      ' aria-label="' + (scored ? 'Edit score, ' : 'Enter score, ') + m.a.map(x => pname(x)).join(' and ') + ' versus ' + m.b.map(x => pname(x)).join(' and ') +
      (scored ? ', currently ' + m.sa + ' to ' + m.sb : '') + '">' +
      (scored ? m.sa + '<span class="sep">&#8211;</span>' + m.sb : 'Enter score') + '</button></div>' +
      '<div class="side bot ' + (scored && m.sb > m.sa ? 'win' : '') + '"><div class="team"><div class="nm">' + teamName(m.b) + '</div></div></div>' +
      '</div></div>';
  });

  h += '</div>';

  if (r.resting && r.resting.length) {
    h += '<div class="bench"><span class="lbl">Sitting out</span>' +
      r.resting.map(id => '<span class="bav" title="' + esc(pname(id)) + '" aria-label="' + esc(pname(id)) + '">' + av(id) + '</span>').join('') + '</div>';
  }

  /* controls */
  const done = roundDone(r);
  if (ev.status === 'live') {
    const rows = [];
    if (idx < total - 1) {
      rows.push('<button class="btn" data-a="goto-round" data-i="' + (idx + 1) + '">Round ' + (idx + 2) + ' &#8594;</button>');
    } else if (ev.format === 'mexicano' && done && total < roundsPlanned(ev)) {
      rows.push('<button class="btn primary" data-a="next-round">Draw round ' + (total + 1) +
        ' <span style="opacity:.6;font-weight:600">of ' + roundsPlanned(ev) + '</span></button>');
    }
    if (done && idx === total - 1) rows.push('<button class="btn" data-a="finish-event">Finish event</button>');
    if (rows.length) h += '<div class="stickwrap">' + rows.map(b => '<div class="btn-row">' + b + '</div>').join('') + '</div>';
  }
  h += '</div><div class="colB">';

  h += '<div class="divide"><span class="eyebrow">Table</span><span class="rule"></span></div><div class="panel">' +
    (ev.format === 'roundrobin' ? teamTableHTML(ev) : tableHTML(standings(ev), 'Pts')) + '</div></div></div>';
  return h;
}

/* ── quick match ── */
function vNewMatch() {
  const d = draft;
  let h = head('Quick match', 'Line-up');
  h += '<div class="panel"><div style="display:flex;gap:8px"><input class="inp" id="newp" placeholder="Add someone new" autocomplete="off" maxlength="24">' +
    '<button class="btn small primary" data-a="add-player" style="min-width:74px">Add</button></div></div>';
  h += '<div class="divide"><span class="eyebrow">Playing (' + d.ids.length + ')</span><span class="rule"></span></div><div class="pickgrid">';
  S.players.forEach(p => {
    const on = d.ids.indexOf(p.id) >= 0;
    h += '<button class="pick ' + (on ? 'on' : '') + '" data-a="toggle-player" data-id="' + p.id + '">' + av(p.id) +
      '<span class="grow">' + esc(p.name) + '</span><span class="tick">&#10003;</span></button>';
  });
  h += '</div>';

  const singles = d.ids.length === 2;
  if (singles || d.ids.length === 4) {
    const t = mSides(d);
    h += '<div class="divide"><span class="eyebrow">' + (singles ? 'Singles' : 'Teams') + '</span><span class="rule"></span>' +
      '<button class="btn ghost small" data-a="swap-sides">' + (singles ? 'Swap ends' : 'Change pairs') + '</button></div>' +
      '<div class="court"><div class="side top"><div class="team"><div class="nm">' + teamName(t[0]) + '</div></div></div>' +
      '<div class="net"></div><div class="side bot"><div class="team"><div class="nm">' + teamName(t[1]) + '</div></div></div></div>';
    h += '<div class="divide"><span class="eyebrow">Rules</span><span class="rule"></span></div><div class="panel">';
    h += '<div class="field" style="margin-top:0"><label class="eyebrow">Sets</label><div class="segs">' +
      [1, 3, 5].map(v => '<button class="seg ' + (d.sets === v ? 'on' : '') + '" data-a="m-sets" data-v="' + v + '">Best of ' + v + '</button>').join('') + '</div></div>';
    h += '<div class="field"><label class="eyebrow">Games per set</label><div class="segs">' +
      [4, 6, 9].map(v => '<button class="seg ' + (d.games === v ? 'on' : '') + '" data-a="m-games" data-v="' + v + '">' + v + '</button>').join('') + '</div></div>';
    h += '<div class="field"><label class="eyebrow">Deuce</label><div class="segs">' +
      '<button class="seg ' + (d.golden ? 'on' : '') + '" data-a="m-golden" data-v="1">Golden point</button>' +
      '<button class="seg ' + (!d.golden ? 'on' : '') + '" data-a="m-golden" data-v="0">Advantage</button></div></div>';
    if (d.sets > 1) {
      h += '<div class="field"><label class="eyebrow">Deciding set</label><div class="segs">' +
        '<button class="seg ' + (d.superTb ? 'on' : '') + '" data-a="m-stb" data-v="1">Super tiebreak</button>' +
        '<button class="seg ' + (!d.superTb ? 'on' : '') + '" data-a="m-stb" data-v="0">Full set</button></div></div>';
    }
    h += '</div><div class="btn-row stick"><button class="btn primary" data-a="create-match">Start match</button></div>';
  } else {
    h += '<div class="hint">Pick two for singles, or four for doubles.</div>';
  }
  return h;
}
function mSides(d) {
  if (!d.order || d.order.length !== d.ids.length || d.order.some(x => d.ids.indexOf(x) < 0)) d.order = d.ids.slice();
  if (d.ids.length === 2) return [[d.order[0]], [d.order[1]]];
  return [[d.order[0], d.order[1]], [d.order[2], d.order[3]]];
}

function vMatch() {
  const m = S.matches.find(x => x.id === view.id);
  if (!m) return vHome();
  const w = matchWinner(m);
  let h = '<button class="backlink" data-a="back">&#8592; Back</button>' +
    '<div class="pagehead"><div><div class="eyebrow">' + (m.a.length === 1 ? 'Singles' : 'Doubles') + ' &middot; ' + fmtDate(m.created) + '</div>' +
    '<h1>Best of ' + m.cfg.sets + '</h1></div>' +
    '<span class="pill ' + (w ? 'ball' : '') + '">' + (w ? 'Result in' : 'In play') + '</span></div>';

  const sw = setsWon(m);
  h += '<div class="court ' + (w ? 'done' : '') + '">' +
    '<div class="side top ' + (w === 'a' ? 'win' : '') + '"><div class="team"><div class="nm">' + teamName(m.a) + '</div></div></div>' +
    '<div class="net"><span class="netscore">' + sw.a + '<span class="sep">&#8211;</span>' + sw.b + '</span></div>' +
    '<div class="side bot ' + (w === 'b' ? 'win' : '') + '"><div class="team"><div class="nm">' + teamName(m.b) + '</div></div></div></div>';

  h += '<div class="divide"><span class="eyebrow">Sets</span><span class="rule"></span></div><div class="panel"><div class="setrows">';
  for (let i = 0; i < m.cfg.sets; i++) {
    const s = m.sets[i] || { a: '', b: '' };
    const decider = m.cfg.superTb && i === m.cfg.sets - 1 && m.cfg.sets > 1;
    h += '<div class="setrow"><span class="lbl">' + (decider ? 'STB' : 'Set ' + (i + 1)) + '</span>' +
      '<input type="number" inputmode="numeric" data-set="' + i + '" data-side="a" value="' + (s.a === '' ? '' : s.a) + '" placeholder="&#8211;">' +
      '<span class="d">&#8211;</span>' +
      '<input type="number" inputmode="numeric" data-set="' + i + '" data-side="b" value="' + (s.b === '' ? '' : s.b) + '" placeholder="&#8211;">' +
      '<span class="d" style="width:14px">' + (s.a !== '' && s.b !== '' ? (s.a > s.b ? '&#9650;' : s.a < s.b ? '&#9660;' : '') : '') + '</span></div>';
  }
  h += '</div><div class="hint">' + (m.cfg.superTb && m.cfg.sets > 1 ? 'Deciding set is a super tiebreak. ' : '') +
    (m.cfg.golden ? 'Golden point at deuce.' : 'Advantage scoring.') + '</div></div>';
  h += '<div class="btn-row"><button class="btn primary" data-a="save-sets">Save score</button></div>' +
    '<div class="btn-row"><button class="btn ghost small danger" data-a="del-match" data-id="' + m.id + '" style="width:100%">Delete match</button></div>';
  return h;
}
function setsWon(m) {
  let a = 0, b = 0;
  m.sets.forEach(s => { if (s.a === '' || s.b === '' || s.a == null) return; if (+s.a > +s.b) a++; else if (+s.b > +s.a) b++; });
  return { a: a, b: b };
}
function matchWinner(m) {
  const s = setsWon(m), need = Math.ceil(m.cfg.sets / 2);
  return s.a >= need ? 'a' : s.b >= need ? 'b' : null;
}

/* ══════════ sheets ══════════ */
function renderSheet() {
  const L = $('#layer');
  if (!sheet) { L.innerHTML = ''; return; }
  if (sheet.kind === 'squad') return renderSquadSheet(L);
  if (sheet.kind === 'confirm') {
    L.innerHTML = '<div class="scrim" data-a="close-sheet"></div><div class="sheet"><div class="grab"></div>' +
      '<h3>' + esc(sheet.title) + '</h3><div class="sub">' + esc(sheet.body) + '</div>' +
      '<div class="btn-row"><button class="btn ghost" data-a="close-sheet">Cancel</button>' +
      '<button class="btn ' + (sheet.danger ? 'danger' : 'primary') + '" data-a="confirm-yes">' + esc(sheet.label) + '</button></div></div>';
    return;
  }
  if (sheet.kind === 'eventmenu') {
    const ev = S.events.find(e => e.id === sheet.ev);
    if (!ev) { sheet = null; return renderSheet(); }
    const r = ev.rounds[view.r] || ev.rounds[0];
    const untouched = r && r.matches.every(m => m.sa == null && m.sb == null);
    let items = '';
    if (ev.status === 'live' && untouched) items += '<button data-a="redraw-round" data-i="' + view.r + '">Redraw this round</button>';
    if (ev.status === 'live' && ev.format !== 'roundrobin') items += '<button data-a="squad-sheet">Who is playing</button>';
    items += '<button data-a="run-it-back">Run it back</button>';
    items += '<button data-a="share-event">Copy the table</button>';
    items += '<button class="danger" data-a="del-event" data-id="' + ev.id + '">Delete event</button>';
    L.innerHTML = '<div class="scrim" data-a="close-sheet"></div><div class="sheet"><div class="grab"></div>' +
      '<h3>' + esc(ev.name) + '</h3><div class="sub">' + esc(FORMATS[ev.format].n) + ' &middot; ' +
      evProgress(ev) + ' of ' + roundsPlanned(ev) + ' rounds played</div>' +
      '<div class="menu">' + items + '</div>' +
      '<div class="btn-row"><button class="btn ghost" data-a="close-sheet" style="width:100%">Close</button></div></div>';
    return;
  }
  if (sheet.kind === 'restore') {
    L.innerHTML = '<div class="scrim" data-a="close-sheet"></div><div class="sheet"><div class="grab"></div>' +
      '<h3>Restore a backup</h3><div class="sub">Paste the backup text. This replaces everything currently here.</div>' +
      '<textarea class="inp" id="restoreinp" rows="5" placeholder="Paste here" style="resize:none;font-size:13px"></textarea>' +
      '<div class="btn-row"><button class="btn ghost" data-a="close-sheet">Cancel</button>' +
      '<button class="btn primary" data-a="do-restore">Restore</button></div></div>';
    const t = document.getElementById('restoreinp'); if (t) t.focus();
    return;
  }
  if (sheet.kind === 'rename') {
    L.innerHTML = '<div class="scrim" data-a="close-sheet"></div><div class="sheet"><div class="grab"></div>' +
      '<h3>Rename</h3><div class="sub">This updates them everywhere, past results included.</div>' +
      '<input class="inp" id="renameinp" maxlength="24" value="' + esc(sheet.name) + '" autocomplete="off">' +
      '<div class="btn-row"><button class="btn ghost" data-a="close-sheet">Cancel</button>' +
      '<button class="btn primary" data-a="save-rename">Save</button></div></div>';
    const r = document.getElementById('renameinp'); if (r) { r.focus(); r.select(); }
    return;
  }
  const ev = S.events.find(e => e.id === sheet.ev);
  const m = ev.rounds[sheet.r].matches[sheet.m];
  const target = ev.format === 'roundrobin' ? ev.config.points : ev.config.points;
  const a = sheet.sa === '' ? '' : sheet.sa, b = sheet.sb === '' ? '' : sheet.sb;
  const tot = (a === '' ? 0 : +a) + (b === '' ? 0 : +b);
  const mismatch = a !== '' && b !== '' && tot !== target;

  L.innerHTML = '<div class="scrim" data-a="close-sheet"></div><div class="sheet"><div class="grab"></div>' +
    '<h3>Round ' + (sheet.r + 1) + ' &middot; Court ' + m.court + '</h3>' +
    '<div class="sub">Playing to ' + target + '</div>' +
    '<div class="scorepad">' +
    '<div class="spside"><div class="nm">' + m.a.map(x => esc(pname(x))).join(' & ') + '</div>' +
    '<input class="num" type="number" inputmode="numeric" id="sa" value="' + a + '" placeholder="0" aria-label="Points for ' + m.a.map(x => pname(x)).join(' and ') + '">' +
    '<div class="pm"><button data-a="nudge" data-s="a" data-v="-1">&#8722;</button><button data-a="nudge" data-s="a" data-v="1">+</button></div></div>' +
    '<div class="spvs">v</div>' +
    '<div class="spside"><div class="nm">' + m.b.map(x => esc(pname(x))).join(' & ') + '</div>' +
    '<input class="num" type="number" inputmode="numeric" id="sb" value="' + b + '" placeholder="0" aria-label="Points for ' + m.b.map(x => pname(x)).join(' and ') + '">' +
    '<div class="pm"><button data-a="nudge" data-s="b" data-v="-1">&#8722;</button><button data-a="nudge" data-s="b" data-v="1">+</button></div></div>' +
    '</div>' +
    '<div class="hint" id="spwarn" role="status" style="color:var(--amber);text-align:center;min-height:18px">' +
    (mismatch ? 'That adds up to ' + tot + ', not ' + target + '. Saving anyway is fine.' : '') + '</div>' +
    '<div class="btn-row"><button class="btn ghost" data-a="close-sheet">Cancel</button>' +
    '<button class="btn primary" data-a="save-score">Save score</button></div></div>';

  ['sa', 'sb'].forEach(k => {
    const el = document.getElementById(k);
    el.addEventListener('input', () => {
      sheet[k] = el.value === '' ? '' : Math.max(0, parseInt(el.value, 10) || 0);
      if (sheet.auto && k === 'sa' && sheet.sa !== '' && sheet.sa <= target) sheet.sb = target - sheet.sa;
      paintSheet();
    });
    el.addEventListener('focus', () => { if (k === 'sb') sheet.auto = false; });
  });
}
function renderSquadSheet(L) {
  const ev = S.events.find(e => e.id === sheet.ev);
  const played = {};
  ev.rounds.forEach(r => r.matches.forEach(m => { if (m.sa != null) m.a.concat(m.b).forEach(i => played[i] = 1); }));
  L.innerHTML = '<div class="scrim" data-a="close-sheet"></div><div class="sheet"><div class="grab"></div>' +
    '<h3>Who is playing</h3><div class="sub">Rounds already scored stay put. The rest get redrawn.</div>' +
    '<div style="display:flex;gap:8px;margin-bottom:14px"><input class="inp" id="newp" placeholder="Add someone new" autocomplete="off" maxlength="24">' +
    '<button class="btn small primary" data-a="add-player" style="min-width:74px">Add</button></div>' +
    '<div class="pickgrid">' + S.players.map(p => {
      const on = sheet.ids.indexOf(p.id) >= 0;
      return '<button class="pick ' + (on ? 'on' : '') + '" data-a="squad-toggle" data-id="' + p.id + '">' + av(p.id) +
        '<span class="grow">' + esc(p.name) + (played[p.id] && !on ? ' <span style="color:var(--glass-dim)">(played)</span>' : '') +
        '</span><span class="tick">&#10003;</span></button>';
    }).join('') + '</div>' +
    '<div class="hint">' + (sheet.ids.length < 4 ? 'You need at least four.' :
      sheet.ids.length + ' playing' + (sheet.ids.length % 4 ? ', ' + (sheet.ids.length % (ev.config.courts * 4)) + ' resting each round' : '')) + '</div>' +
    '<div class="btn-row"><button class="btn ghost" data-a="close-sheet">Cancel</button>' +
    '<button class="btn primary" data-a="save-squad" ' + (sheet.ids.length < 4 ? 'disabled' : '') + '>Redraw</button></div></div>';
}
function paintSheet() {
  if (!sheet) return;
  const ev = S.events.find(e => e.id === sheet.ev); if (!ev) return;
  const target = ev.config.points;
  ['sa', 'sb'].forEach(k => {
    const el = document.getElementById(k);
    if (el && document.activeElement !== el) el.value = sheet[k] === '' ? '' : sheet[k];
  });
  const tot = (sheet.sa === '' ? 0 : +sheet.sa) + (sheet.sb === '' ? 0 : +sheet.sb);
  const w = document.getElementById('spwarn');
  if (w) w.textContent = (sheet.sa !== '' && sheet.sb !== '' && tot !== target) ?
    'That adds up to ' + tot + ', not ' + target + '. Saving anyway is fine.' : '';
}

/* ══════════ render ══════════ */
const VIEWS = { home: vHome, players: vPlayers, history: vHistory, newevent: vNewEvent, event: vEvent, newmatch: vNewMatch, match: vMatch, profile: vProfile };
function render() {
  $('#app').innerHTML = (VIEWS[view.name] || vHome)();
  const tabs = [['home', '&#9650;', 'Court'], ['players', '&#9679;', 'Players'], ['history', '&#9632;', 'History']];
  $('#nav').innerHTML = tabs.map(t => '<button class="' + (view.name === t[0] ? 'on' : '') + '"' + (view.name === t[0] ? ' aria-current="page"' : '') + ' data-a="tab-' + t[0] + '">' +
    '<span class="g" aria-hidden="true">' + t[1] + '</span><span class="t">' + t[2] + '</span></button>').join('');
  paintBanner();
  renderSheet();
}

/* ══════════ actions ══════════ */
document.addEventListener('click', e => {
  const el = e.target.closest('[data-a]'); if (!el) return;
  const a = el.dataset.a; const d = draft;
  if (sheet && sheet.kind === 'eventmenu' && a !== 'close-sheet') { sheet = null; renderSheet(); }

  if (a === 'back') { history.length > 1 ? go(view.from || 'home') : go('home'); return; }
  if (a.indexOf('tab-') === 0) { go(a.slice(4) === 'home' ? 'home' : a.slice(4)); return; }

  if (a === 'add-player') {
    const inp = document.getElementById('newp'); const n = (inp.value || '').trim();
    if (!n) { inp.focus(); return; }
    if (S.players.some(p => p.name.toLowerCase() === n.toLowerCase())) { toast(n + ' is already in the squad'); inp.value = ''; return; }
    const p = { id: uid(), name: n, c: S.players.length };
    S.players.push(p); save();
    if (sheet && sheet.kind === 'squad') { sheet.ids.push(p.id); renderSheet(); const si = document.getElementById('newp'); if (si) si.focus(); return; }
    if (draft && draft.ids && (view.name === 'newevent' || view.name === 'newmatch')) {
      if (view.name === 'newmatch' ? draft.ids.length < 4 : true) draft.ids.push(p.id);
    }
    render(); const ni = document.getElementById('newp'); if (ni) ni.focus();
    return;
  }
  if (a === 'del-player') {
    const id = el.dataset.id;
    if (S.events.some(ev => ev.playerIds.indexOf(id) >= 0) || S.matches.some(m => m.a.concat(m.b).indexOf(id) >= 0)) {
      toast('Played already, so they stay in the log'); return;
    }
    S.players = S.players.filter(p => p.id !== id); save(); render(); return;
  }

  /* wizard */
  if (a === 'new-event') { draft = { step: 0, name: '', format: 'americano', ids: [], courts: 1, points: 24, rounds: 6, double: false, teams: null }; go('newevent', { from: 'home' }); return; }
  if (a === 'set-format') { const nm = document.getElementById('evname'); if (nm) d.name = nm.value; d.format = el.dataset.k; render(); return; }
  if (a === 'wiz-next') {
    if (d.step === 0) {
      const nm = document.getElementById('evname'); if (nm) d.name = nm.value.trim();
      if (!d.name) d.name = FORMATS[d.format].n + ' ' + fmtDate(Date.now());
    }
    if (d.step === 1) {
      d.courts = Math.max(1, Math.min(d.courts, Math.floor(d.ids.length / 4)));
      d.rounds = defaultRounds(d.ids.length, d.courts);
      if (d.format === 'roundrobin') { d.points = 16; d.teams = null; }
    }
    d.step++; render(); window.scrollTo(0, 0); return;
  }
  if (a === 'toggle-player') {
    const id = el.dataset.id, i = d.ids.indexOf(id);
    if (i >= 0) d.ids.splice(i, 1);
    else { if (view.name === 'newmatch' && d.ids.length >= 4) { toast('Two for singles, four for doubles'); return; } d.ids.push(id); }
    d.teams = null; d.order = null; render(); return;
  }
  if (a === 'set-courts') { d.courts = +el.dataset.v; d.rounds = defaultRounds(d.ids.length, d.courts); render(); return; }
  if (a === 'set-points') { d.points = +el.dataset.v; render(); return; }
  if (a === 'pts') { d.points = Math.max(4, Math.min(99, d.points + (+el.dataset.v))); render(); return; }
  if (a === 'rds') { d.rounds = Math.max(1, Math.min(30, d.rounds + (+el.dataset.v))); render(); return; }
  if (a === 'set-double') { d.double = el.dataset.v === '1'; render(); return; }
  if (a === 'shuffle-teams') { d.teams = null; pairUp(d); render(); return; }

  if (a === 'create-event') {
    const ev = {
      id: uid(), name: d.name, format: d.format, created: Date.now(), status: 'live',
      playerIds: d.ids.slice(), rounds: [],
      config: { courts: d.courts, points: d.points, rounds: d.rounds, doubleRound: d.double, teams: d.format === 'roundrobin' ? pairUp(d) : null }
    };
    if (d.format === 'roundrobin') ev.rounds = rrRounds(ev);
    else if (d.format === 'mexicano') ev.rounds = [buildRound(ev, 1)];
    else for (let i = 1; i <= d.rounds; i++) ev.rounds.push(buildRound(ev, i));
    S.events.push(ev); save(); draft = null; go('event', { id: ev.id, r: 0, from: 'home' }); return;
  }

  /* event */
  if (a === 'open-event') { go('event', { id: el.dataset.id, from: view.name }); return; }
  if (a === 'goto-round') { view.r = +el.dataset.i; view.tab = 'round'; render(); window.scrollTo(0, 0); return; }
  if (a === 'ev-tab') { view.tab = el.dataset.v; render(); window.scrollTo(0, 0); return; }
  if (a === 'event-menu') { sheet = { kind: 'eventmenu', ev: view.id }; renderSheet(); return; }
  if (a === 'redraw-round') {
    const ev = S.events.find(x => x.id === view.id);
    const changed = redrawRound(ev, +el.dataset.i);
    save(); render();
    toast(changed ? 'Redrawn' : 'That is already the fairest draw'); return;
  }
  if (a === 'squad-sheet') {
    const ev = S.events.find(x => x.id === view.id);
    sheet = { kind: 'squad', ev: ev.id, ids: ev.playerIds.slice() }; renderSheet(); return;
  }
  if (a === 'squad-toggle') {
    const i = sheet.ids.indexOf(el.dataset.id);
    if (i >= 0) sheet.ids.splice(i, 1); else sheet.ids.push(el.dataset.id);
    renderSheet(); return;
  }
  if (a === 'save-squad') {
    const ev = S.events.find(x => x.id === sheet.ev);
    ev.playerIds = sheet.ids.slice();
    ev.config.courts = Math.max(1, Math.min(ev.config.courts, Math.floor(ev.playerIds.length / 4)));
    rebuildFuture(ev); save(); sheet = null;
    view.r = Math.min(evProgress(ev), ev.rounds.length - 1);
    render(); toast('Rounds redrawn'); return;
  }
  if (a === 'run-it-back') {
    const o = S.events.find(x => x.id === view.id);
    const ev = { id: uid(), name: o.name, format: o.format, created: Date.now(), status: 'live',
      playerIds: o.playerIds.slice(), rounds: [], config: JSON.parse(JSON.stringify(o.config)) };
    if (ev.format === 'roundrobin') ev.rounds = rrRounds(ev);
    else if (ev.format === 'mexicano') ev.rounds = [buildRound(ev, 1)];
    else for (let i = 1; i <= (ev.config.rounds || 6); i++) ev.rounds.push(buildRound(ev, i));
    S.events.push(ev); save();
    go('event', { id: ev.id, r: 0, from: 'home' }); toast('Fresh draw, same crew'); return;
  }
  if (a === 'open-profile') { go('profile', { id: el.dataset.id, from: 'players' }); return; }
  if (a === 'rename-player') {
    const p = S.players.find(x => x.id === el.dataset.id);
    sheet = { kind: 'rename', pid: p.id, name: p.name }; renderSheet(); return;
  }
  if (a === 'save-rename') {
    const inp = document.getElementById('renameinp'), n = (inp.value || '').trim();
    if (!n) { inp.focus(); return; }
    const p = S.players.find(x => x.id === sheet.pid);
    p.name = n; save(); sheet = null; render(); return;
  }
  if (a === 'confirm-yes') { const fn = pending; pending = null; sheet = null; renderSheet(); if (fn) fn(); return; }
  if (a === 'next-round') {
    const ev = S.events.find(x => x.id === view.id);
    ev.rounds.push(buildRound(ev, ev.rounds.length + 1));
    save(); view.r = ev.rounds.length - 1; render(); window.scrollTo(0, 0); return;
  }
  if (a === 'finish-event') {
    const ev = S.events.find(x => x.id === view.id);
    ev.status = 'done'; save(); render(); toast('Event finished'); return;
  }
  if (a === 'del-event') {
    const id = el.dataset.id, ev = S.events.find(x => x.id === id);
    askConfirm('Delete ' + (ev ? ev.name : 'event') + '?', 'Every round and score in it goes with it. This cannot be undone.',
      'Delete', true, () => { S.events = S.events.filter(x => x.id !== id); save(); go('history'); toast('Event deleted'); });
    return;
  }

  /* score sheet */
  if (a === 'score') {
    const ev = S.events.find(x => x.id === view.id);
    const m = ev.rounds[+el.dataset.r].matches[+el.dataset.m];
    sheet = { ev: ev.id, r: +el.dataset.r, m: +el.dataset.m, sa: m.sa == null ? '' : m.sa, sb: m.sb == null ? '' : m.sb, auto: m.sa == null };
    renderSheet(); setTimeout(() => { const x = document.getElementById('sa'); if (x) x.focus(); }, 60); return;
  }
  if (a === 'close-sheet') { sheet = null; renderSheet(); return; }
  if (a === 'nudge') {
    const k = el.dataset.s === 'a' ? 'sa' : 'sb';
    sheet[k] = Math.max(0, (sheet[k] === '' ? 0 : +sheet[k]) + (+el.dataset.v));
    if (sheet.auto) { const ev = S.events.find(x => x.id === sheet.ev); const t = ev.config.points; const o = k === 'sa' ? 'sb' : 'sa'; if (sheet[k] <= t) sheet[o] = t - sheet[k]; }
    paintSheet(); return;
  }
  if (a === 'save-score') {
    const ev = S.events.find(x => x.id === sheet.ev);
    const m = ev.rounds[sheet.r].matches[sheet.m];
    if (sheet.sa === '' || sheet.sb === '') { toast('Both scores, please'); return; }
    const prev = { sa: m.sa, sb: m.sb }, ri = sheet.r, mi = sheet.m;
    m.sa = +sheet.sa; m.sb = +sheet.sb; save(); sheet = null;
    const rr = ev.rounds[ri];
    let finished = false;
    if (ev.status === 'live' && eventComplete(ev)) { ev.status = 'done'; finished = true; save(); }
    else if (roundDone(rr) && ri + 1 < ev.rounds.length) view.r = ri + 1;
    render();
    const undo = () => {
      const e2 = S.events.find(x => x.id === ev.id);
      e2.rounds[ri].matches[mi].sa = prev.sa; e2.rounds[ri].matches[mi].sb = prev.sb;
      if (finished) e2.status = 'live';
      save(); view.r = ri; render();
    };
    if (finished) { const w = winnerOf(ev); toast(w ? w.who + ' wins it' : 'Event complete', 'Undo', undo); }
    else toast('Saved', 'Undo', undo);
    return;
  }

  /* quick match */
  if (a === 'new-match') { draft = { ids: [], order: null, sets: 3, games: 6, golden: true, superTb: true }; go('newmatch', { from: 'home' }); return; }
  if (a === 'swap-sides') {
    const o = mSides(d);
    if (d.ids.length === 2) { d.order = [o[1][0], o[0][0]]; }
    else {
      /* hold the first player and rotate who partners them, so all three pairings come round */
      const anchor = o[0][0], rest = [o[0][1], o[1][0], o[1][1]];
      d.order = [anchor, rest[1], rest[2], rest[0]];
    }
    render(); return;
  }
  if (a === 'm-sets') { d.sets = +el.dataset.v; render(); return; }
  if (a === 'm-games') { d.games = +el.dataset.v; render(); return; }
  if (a === 'm-golden') { d.golden = el.dataset.v === '1'; render(); return; }
  if (a === 'm-stb') { d.superTb = el.dataset.v === '1'; render(); return; }
  if (a === 'create-match') {
    const t = mSides(d);
    const m = { id: uid(), created: Date.now(), a: t[0], b: t[1], sets: [], cfg: { sets: d.sets, games: d.games, golden: d.golden, superTb: d.superTb } };
    S.matches.push(m); save(); draft = null; go('match', { id: m.id, from: 'home' }); return;
  }
  if (a === 'open-match') { go('match', { id: el.dataset.id, from: view.name }); return; }
  if (a === 'save-sets') {
    const m = S.matches.find(x => x.id === view.id); const out = [];
    document.querySelectorAll('.setrow').forEach((row, i) => {
      const ia = row.querySelector('[data-side="a"]'), ib = row.querySelector('[data-side="b"]');
      out[i] = { a: ia.value === '' ? '' : +ia.value, b: ib.value === '' ? '' : +ib.value };
    });
    m.sets = out; save(); render(); toast('Score saved'); return;
  }
  if (a === 'del-match') {
    const id = el.dataset.id;
    askConfirm('Delete this match?', 'The sets you entered go with it. This cannot be undone.',
      'Delete', true, () => { S.matches = S.matches.filter(x => x.id !== id); save(); go('history'); toast('Match deleted'); });
    return;
  }

  if (a === 'share-event') {
    const ev = S.events.find(x => x.id === view.id);
    const lines = [ev.name, FORMATS[ev.format].n + ' \u00b7 ' + fmtDate(ev.created) + ' \u00b7 ' + evProgress(ev) + ' rounds played', ''];
    (ev.format === 'roundrobin' ? teamTable(ev) : standings(ev)).forEach((r, i) => {
      const who = ev.format === 'roundrobin' ? r.ids.map(x => pname(x)).join(' & ') : pname(r.id);
      lines.push((i + 1) + '. ' + who + '  ' + r.pf + '  (' + (r.diff > 0 ? '+' : '') + r.diff + ')');
    });
    const txt = lines.join('\n');
    if (navigator.clipboard) navigator.clipboard.writeText(txt).then(() => toast('Table copied'), () => toast('Could not copy'));
    else toast('Could not copy');
    return;
  }
  if (a === 'hide-banner') { bannerHidden = true; paintBanner(); return; }
  if (a === 'copy-backup') {
    const txt = JSON.stringify(S);
    if (navigator.clipboard) navigator.clipboard.writeText(txt).then(
      () => toast('Backup copied, paste it somewhere safe'), () => toast('Could not copy'));
    else toast('Could not copy');
    return;
  }
  if (a === 'restore') { sheet = { kind: 'restore' }; renderSheet(); return; }
  if (a === 'do-restore') {
    const t = document.getElementById('restoreinp');
    let d = null;
    try { d = JSON.parse((t.value || '').trim()); } catch (e) { }
    if (!d || !Array.isArray(d.players)) { toast('That is not a PISTA backup'); return; }
    S = { players: d.players || [], events: d.events || [], matches: d.matches || [] };
    save(); sheet = null; go('home');
    toast(S.players.length + ' players, ' + S.events.length + ' events restored');
    return;
  }
  if (a === 'wipe') {
    askConfirm('Clear everything?', 'Every player, event and match goes. Export first if you want a copy.',
      'Clear it all', true, () => {
        S = { players: [], events: [], matches: [] };
        lsDel(KEY);
        save(); go('home'); toast('Cleared');
      });
    return;
  }
  if (a === 'export') {
    const blob = new Blob([JSON.stringify(S, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob), link = document.createElement('a');
    link.href = url; link.download = 'pista-data.json'; link.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    toast('Exported'); return;
  }
});

document.addEventListener('keydown', e => {
  if (e.key === 'Enter' && e.target.id === 'newp') { e.preventDefault(); document.querySelector('[data-a="add-player"]').click(); }
  if (e.key === 'Escape' && sheet) { sheet = null; renderSheet(); }
});

/* ── boot ── */
(function () { load(); if (mode === 'none') probe(); render(); })();

		</script>
	</body>
</html>
