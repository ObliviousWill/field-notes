      h += '<div class="divide"><span class="eyebrow">Pairs</span><span class="rule"></span>' +
        '<button class="btn ghost small" data-a="shuffle-teams">Shuffle</button></div><div class="panel">';
      pairUp(d).forEach((t, i) => {
