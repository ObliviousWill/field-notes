  } else {
    const at = {}; allTime().forEach(r => at[r.id] = r);
    h += '<div class="panel plist" style="margin-top:12px">';
    S.players.forEach(p => {
      const s = at[p.id];
      h += '<div class="row"><button style="background:none;border:0;padding:0;display:flex;align-items:center;gap:12px;flex:1;min-width:0;color:inherit;text-align:left" ' +
        'data-a="open-profile" data-id="' + p.id + '">' + av(p.id) + '<span class="grow"><span class="nm" style="display:block">' + esc(p.name) + '</span>' +
