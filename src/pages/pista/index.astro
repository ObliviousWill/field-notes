    });
    h += '</div>';
    const ok = d.format === 'roundrobin' ? d.ids.length >= 4 : d.ids.length >= 4;
    h += '<div class="hint">' + (d.ids.length < 4 ? 'You need at least four players.' :
      d.format === 'roundrobin' ? (d.ids.length % 2 ? 'Fixed pairs needs an even number.' : 'That is ' + (d.ids.length / 2) + ' pairs.') :
      (d.ids.length % 4 ? (d.ids.length % 4) + ' will rest each round, rotating fairly.' : 'Everyone plays every round.')) + '</div>';
    h += '<div class="btn-row stick"><button class="btn primary" data-a="wiz-next" ' + (ok && !(d.format === 'roundrobin' && d.ids.length % 2) ? '' : 'disabled') + '>Set the rules</button></div>';
  }

  if (d.step === 2) {
    const maxC = Math.floor(d.ids.length / 4);
    h += '<div class="panel"><div class="field" style="margin-top:0"><label class="eyebrow">Courts</label><div class="segs">';
    for (let i = 1; i <= Math.max(1, maxC); i++) h += '<button class="seg ' + (d.courts === i ? 'on' : '') + '" data-a="set-courts" data-v="' + i + '">' + i + '</button>';
    h += '</div></div></div>';

    if (d.format === 'roundrobin') {
      h += '<div class="panel"><div class="field" style="margin-top:0"><label class="eyebrow">Games per match</label><div class="stepper">' +
        '<button data-a="pts" data-v="-1">&#8722;</button><span class="val">' + d.points + '</span><button data-a="pts" data-v="1">+</button></div>' +
        '<div class="hint">First pair to ' + d.points + '. Enter both scores at the end of the match.</div></div>';
      h += '<div class="field"><label class="eyebrow">Fixtures</label><div class="segs">' +
        '<button class="seg ' + (!d.double ? 'on' : '') + '" data-a="set-double" data-v="0">Single</button>' +
