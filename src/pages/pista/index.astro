}

/* ── history ── */
function vHistory() {
  let h = '<div class="pagehead"><div><div class="eyebrow">Log</div><h1>History</h1></div></div>';
  const items = S.events.map(e => ({ t: 'e', d: e.created, o: e })).concat(S.matches.map(m => ({ t: 'm', d: m.created, o: m })))
    .sort((a, b) => b.d - a.d);
  if (!items.length) return h + '<div class="empty"><div class="g" aria-hidden="true">&#9679;</div><p>Every event and match you finish lands here, with the final table.</p></div>';
  h += '<div class="panel">';
  items.forEach(it => {
    if (it.t === 'e') {
      const e = it.o, top = e.format === 'roundrobin' ? teamTable(e)[0] : standings(e)[0];
      const winner = top && top.pl ? (e.format === 'roundrobin' ? top.ids.map(x => pname(x)).join(' & ') : pname(top.id)) : '—';
      h += '<button class="row" data-a="open-event" data-id="' + e.id + '"><div class="grow"><div class="nm">' + esc(e.name) + '</div>' +
        '<div class="sub">' + fmtDate(e.created) + ' &middot; ' + FORMATS[e.format].n + ' &middot; ' +
        (e.status === 'live' ? 'in play' : 'won by ' + esc(winner)) + '</div></div>' +
        (e.status === 'live' ? '<span class="pill ball">Live</span>' : '') + '<span class="go">&#8250;</span></button>';
    } else {
      const m = it.o;
      h += '<button class="row" data-a="open-match" data-id="' + m.id + '"><div class="grow">' +
        '<div class="nm">' + m.a.map(x => esc(pname(x))).join(' & ') + ' v ' + m.b.map(x => esc(pname(x))).join(' & ') + '</div>' +
        '<div class="sub">' + fmtDate(m.created) + ' &middot; ' + (m.sets.length ? m.sets.map(s => s.a + '&#8211;' + s.b).join('  ') : 'not scored') + '</div></div>' +
        '<span class="go">&#8250;</span></button>';
    }
  });
  h += '</div>' + storagePanel();
  return h;
}

function storagePanel() {
