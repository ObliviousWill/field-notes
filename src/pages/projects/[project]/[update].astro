---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_AUTHOR } from '../../../consts';
import { updateSlug } from '../../../utils/projects';
import { readingTimeMinutes } from '../../../utils/readingTime';

export async function getStaticPaths() {
	const updates = await getCollection('updates');
	return updates.map((update) => ({
		params: { project: update.data.project.id, update: updateSlug(update) },
		props: { update },
	}));
}

interface Props {
	update: CollectionEntry<'updates'>;
}

const { update } = Astro.props;
const { Content } = await render(update);
const readingTime = readingTimeMinutes(update.body);

const projects = await getCollection('projects');
const project = projects.find((p) => p.id === update.data.project.id);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${update.data.title} · ${project?.data.title ?? 'Update'}`}
			description={project?.data.summary ?? ''}
		/>
		<style>
			.crumbs {
				margin: 2.5em 0 1em;
				color: rgb(var(--text-muted));
				font-size: 0.95em;
			}
			.crumbs a {
				color: var(--accent-ink);
			}
			.update-head {
				margin-bottom: 1.5em;
				padding-bottom: 1em;
				border-bottom: 1px solid rgba(var(--text), 12%);
			}
			.update-head h1 {
				margin: 0 0 0.4em;
				font-size: 2.441em;
				line-height: 1.1;
			}
			.byline {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				color: rgb(var(--text-muted));
				font-size: 0.95em;
				margin: 0;
			}
			.byline .sep {
				opacity: 0.5;
			}
			.byline .author {
				color: rgb(var(--text));
				font-weight: 600;
			}
			.back {
				display: inline-block;
				margin-top: 2em;
				color: var(--accent-ink);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<p class="crumbs">
					<a href={`${base}/projects/`}>Projects</a>
					{
						project && (
							<>
								<span> / </span>
								<a href={`${base}/projects/${project.id}/`}>{project.data.title}</a>
							</>
						)
					}
				</p>
				<header class="update-head">
					<h1>{update.data.title}</h1>
					<p class="byline">
						<span class="author">{SITE_AUTHOR}</span>
						<span class="sep">·</span>
						<FormattedDate date={update.data.pubDate} />
						<span class="sep">·</span>
						<span>{readingTime} min read</span>
					</p>
				</header>
				<Content />
				{
					project && (
						<a class="back" href={`${base}/projects/${project.id}/`}>
							← All updates for {project.data.title}
						</a>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>
