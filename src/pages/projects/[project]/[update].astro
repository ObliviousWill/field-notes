---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import StatusPill from '../../../components/StatusPill.astro';
import { SITE_AUTHOR } from '../../../consts';
import { updateSlug } from '../../../utils/projects';
import { readingTimeMinutes } from '../../../utils/readingTime';

export async function getStaticPaths() {
	const updates = await getCollection('updates');
	return updates.map((update) => ({
		params: { project: update.data.project.id, update: updateSlug(update) },
		props: { update },
	}));
}

interface Props {
	update: CollectionEntry<'updates'>;
}

const { update } = Astro.props;
const { Content } = await render(update);
const readingTime = readingTimeMinutes(update.body);

const projects = await getCollection('projects');
const project = projects.find((p) => p.id === update.data.project.id);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${update.data.title} · ${project?.data.title ?? 'Update'}`}
			description={project?.data.summary ?? ''}
		/>
	</head>
	<body>
		<Header current="projects" />
		<main>
			<div class="crumbs">
				<a class="fn-link" href={`${base}/projects/`}>← All projects</a>
				{
					project && (
						<a class="fn-link" href={`${base}/projects/${project.id}/`}>
							{project.data.title}
						</a>
					)
				}
			</div>

			<header class="update-head">
				{
					project && (
						<div class="context">
							<StatusPill status={project.data.status} />
							<span class="context-label">Update for</span>
							<a class="fn-link" href={`${base}/projects/${project.id}/`}>
								{project.data.title}
							</a>
						</div>
					)
				}
				<h1>{update.data.title}</h1>
				<div class="byline">
					<strong>{SITE_AUTHOR}</strong>
					<span class="sep" aria-hidden="true">·</span>
					<FormattedDate date={update.data.pubDate} />
					<span class="sep" aria-hidden="true">·</span>
					<span>{readingTime} min read</span>
				</div>
			</header>

			<article class="prose">
				<Content />
			</article>

			{
				project && (
					<a class="back fn-link" href={`${base}/projects/${project.id}/`}>
						← All updates for {project.data.title}
					</a>
				)
			}

			<NewsletterBlock />
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		padding-top: 40px;
	}
	.crumbs {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 32px;
		font-size: 13px;
		color: rgb(var(--text-muted));
		flex-wrap: wrap;
		gap: 8px;
	}
	.update-head {
		margin-bottom: 32px;
	}
	.context {
		display: flex;
		align-items: center;
		gap: 10px;
		flex-wrap: wrap;
		margin-bottom: 16px;
		font-size: 13px;
		color: rgb(var(--text-muted));
	}
	.context-label {
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 11px;
		font-weight: 700;
	}
	.update-head h1 {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 44px;
		margin: 0;
		line-height: 1.1;
		letter-spacing: -0.015em;
		color: rgb(var(--text));
	}
	.byline {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		align-items: center;
		font-size: 14px;
		color: rgb(var(--text-muted));
		margin: 18px 0 0;
		padding-top: 18px;
		border-top: 1px solid var(--hairline-soft);
	}
	.byline strong {
		color: rgb(var(--text));
		font-weight: 700;
	}
	.byline .sep {
		opacity: 0.4;
	}
	.prose {
		max-width: 680px;
	}
	.back {
		display: inline-block;
		margin-top: 32px;
		font-size: 14px;
	}
	@media (max-width: 720px) {
		main {
			padding-top: 24px;
		}
		.update-head h1 {
			font-size: 32px;
		}
	}
</style>
