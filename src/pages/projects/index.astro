---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import PageTitle from '../../components/PageTitle.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);

const groups = [
	{
		area: 'work',
		label: 'At work',
		intro:
			'Tools and AI helpers I have built for my day job, running marketing and customer service at a UK children\'s activities business. Names, people and numbers are left out on purpose.',
	},
	{
		area: 'local',
		label: 'For local businesses',
		intro:
			'Demos for small local firms. The idea: show a customer the thing, instead of describing it.',
	},
	{
		area: 'personal',
		label: 'For me',
		intro: 'Side projects, and this site.',
	},
]
	.map((g) => ({ ...g, projects: projects.filter((p) => p.data.area === g.area) }))
	.filter((g) => g.projects.length > 0);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rssUrl = `${base}/projects/rss.xml`;
const blogUrl = `${base}/blog/`;
const description =
	"Everything I've built, explained in plain English: what it is, who it's for, and what I learned. Each project has its own page, with a diary of updates.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects · ${SITE_TITLE}`} description={description} />
	</head>
	<body>
		<Header current="projects" />
		<main>
			<PageTitle
				title="Projects"
				count={projects.length}
				countLabel={projects.length === 1 ? 'project' : 'projects'}
				subtitle={description}
			>
				<a slot="side-link" class="fn-link" href={rssUrl}>RSS ↗</a>
			</PageTitle>


			<hr />

			{
				groups.map((group, i) => (
					<section class:list={['group', { 'group-spaced': i > 0 }]}>
						<div class="group-head">
							<span class="group-label">{group.label}</span>
							<span class="group-rule" aria-hidden="true" />
							<span class="group-count">{group.projects.length}</span>
						</div>
						<p class="group-intro">{group.intro}</p>
						<div class="card-stack">
							{group.projects.map((project) => (
								<ProjectCard project={project} expanded />
							))}
						</div>
					</section>
				))
			}

			<section class="cross-link">
				<div>
					<p class="cl-title">The blog has the thinking behind these.</p>
					<p class="cl-body">
						When a post talks about a project, there's a link to it at the end of the post.
					</p>
				</div>
				<a class="fn-link" href={blogUrl}>Go to the blog →</a>
			</section>

			<NewsletterBlock />
		</main>
		<Footer />
	</body>
</html>
<style>
	.legend {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-top: 14px;
		flex-wrap: wrap;
		font-size: 12px;
		color: rgb(var(--text-muted));
		font-family: var(--font-atkinson);
	}
	.legend .item {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.group {
		margin-top: 0;
	}
	.group-spaced {
		margin-top: 48px;
	}
	.group-intro {
		margin: 0 0 18px;
		max-width: 620px;
		font-size: 15px;
		color: rgb(var(--text-muted));
	}
	.group-head {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-bottom: 18px;
	}
	.group-label {
		font-family: var(--font-atkinson);
		font-weight: 700;
		font-size: 13px;
		color: rgb(var(--text-muted));
		line-height: 1;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}
	.group-rule {
		flex: 1;
		height: 1px;
		background: var(--hairline-soft);
	}
	.group-count {
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgb(var(--text-muted));
		font-weight: 700;
	}
	.card-stack {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.cross-link {
		margin-top: 56px;
		padding: 24px;
		background: var(--bg-soft);
		border: 1px dashed var(--hairline-soft);
		border-radius: 8px;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 12px;
		align-items: center;
	}
	.cl-title {
		font-family: var(--font-atkinson);
		font-weight: 700;
		font-size: 19px;
		color: rgb(var(--text));
		margin: 0 0 6px;
		line-height: 1.25;
		letter-spacing: -0.005em;
	}
	.cl-body {
		color: rgb(var(--text-muted));
		margin: 0;
		font-size: 16px;
		line-height: 1.5;
	}
	@media (max-width: 720px) {
		.group-spaced {
			margin-top: 36px;
		}
		.group-label {
			font-size: 12px;
		}
		.card-stack {
			gap: 14px;
		}
		.cross-link {
			margin-top: 36px;
			padding: 18px;
			grid-template-columns: 1fr;
		}
		.cl-title {
			font-size: 20px;
		}
		.cl-body {
			font-size: 15px;
		}
	}
</style>
